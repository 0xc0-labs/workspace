#!/usr/bin/env bash
# An action's command: opens one of the plugin's popups, `pick` by default.
# An action runs a command, not a pane, so it asks Herdr to open the
# plugin's own pane.
set -euo pipefail
exec "${HERDR_BIN_PATH:-herdr}" plugin pane open --plugin 0xc0-workspace --entrypoint "${1:-pick}"
