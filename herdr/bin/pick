#!/usr/bin/env bash
# The picker popups: lists the workspace and every repo cloned in it, and opens
# the session of the one picked. With --autopilot, lists the repos with their
# autopilot on, off or dead, and turns the one picked on or off.
#
# With --list it prints that list and nothing else, for a front end whose popup
# is not a terminal's (README.md, The picker in the app), one entry a line,
# tab-separated: the directory, the label, and with --autopilot the state. The
# popups of the TUI show the same list. --frontend is passed on to the scripts
# this runs.
#
# Plain bash 3, so a stock macOS runs it.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../.." && pwd)"
usage="usage: pick [--autopilot] [--list] [--frontend tui|app]"

autopilot=false
list=false
front=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --autopilot) autopilot=true ;;
    --list) list=true ;;
    --frontend=*) front=(--frontend "${1#--frontend=}") ;;
    --frontend)
      [ "$#" -ge 2 ] || { echo "$usage" >&2; exit 2; }
      front=(--frontend "$2")
      shift
      ;;
    *) echo "$usage" >&2; exit 2 ;;
  esac
  shift
done

# A state that cannot be read is left empty and the exit status is 1, after
# the whole list: the autopilot's own message is on stderr.
entries() {
  local d state status=0
  if ! $autopilot; then
    printf '%s\t%s\n' "$root" "workspace (orchestrator)"
  fi
  for d in "$root"/.github "$root"/*/; do
    d="${d%/}"
    [ -d "$d/.git" ] || continue
    if $autopilot; then
      state="$("$here/autopilot" state "$d" ${front[@]+"${front[@]}"})" || { state=""; status=1; }
      printf '%s\t%s\t%s\n' "$d" "$(basename "$d")" "$state"
    else
      printf '%s\t%s\n' "$d" "$(basename "$d")"
    fi
  done
  return "$status"
}

if $list; then
  status=0
  entries || status=$?
  exit "$status"
fi

dirs=()
labels=()
while IFS=$'\t' read -r dir label state; do
  dirs+=("$dir")
  if [ -n "$state" ]; then
    labels+=("$(printf '%-16s %s' "$label" "$state")")
  else
    labels+=("$label")
  fi
done < <(entries || true)
[ "${#dirs[@]}" -gt 0 ] || { echo "No repo is cloned in the workspace."; exit 0; }

if $autopilot; then
  echo "Turn a repo's autopilot on or off. A number, or Enter to close."
else
  echo "Open a session. A number, or Enter to close."
fi
echo
i=1
for l in "${labels[@]}"; do
  printf '  %2d  %s\n' "$i" "$l"
  i=$((i + 1))
done
echo
read -r -p "> " choice || exit 0
case "$choice" in
  ''|*[!0-9]*) exit 0 ;;
esac
[ "$choice" -ge 1 ] && [ "$choice" -le "${#dirs[@]}" ] || exit 0
if $autopilot; then
  exec "$here/autopilot" toggle "${dirs[$((choice - 1))]}" ${front[@]+"${front[@]}"}
fi
exec "$here/open-session" "${dirs[$((choice - 1))]}" ${front[@]+"${front[@]}"}
