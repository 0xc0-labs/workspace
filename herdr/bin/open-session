#!/usr/bin/env python3
"""Opens the Claude Code session of one directory of the workspace in its own
space of Herdr, listed under the session's name, or focuses it when it is
already open in any front end that answers.

  the workspace itself   claude -n orchestrator
  a repo                 claude -n <name> "/0xc0:work-issue"

<name> is the repo's, as Herdr takes an agent's (`[a-z][a-z0-9_-]`): dots to
dashes, a leading dot dropped. `.github` is `github`, `offby1.cc`
`offby1-cc`. The same name goes to Herdr and to `claude -n`, so the
orchestrator finds a session by it.

The front end is the one asked for, with --frontend or OXC0_HERDR_FRONTEND;
else the one this runs in; else the app if its window answers, and the TUI if
not (README.md, Opening a session by hand).

Usage: open-session <dir> [--dry-run] [--frontend tui|app]
"""
import os
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
LIB = ROOT / "herdr" / "lib"
USAGE = "usage: open-session <dir> [--dry-run] [--frontend tui|app]"

sys.dont_write_bytecode = True  # importing the layer would leave a __pycache__ in the checkout
sys.path.insert(0, str(LIB))
import frontend  # noqa: E402


def options(argv):
    """(dry, front end asked for) from what follows the directory."""
    dry, asked, rest = False, None, list(argv)
    while rest:
        arg = rest.pop(0)
        if arg == "--dry-run":
            dry = True
        elif arg.startswith("--frontend="):
            asked = arg.partition("=")[2]
        elif arg == "--frontend" and rest:
            asked = rest.pop(0)
        else:
            sys.exit(USAGE)
    if asked == "":
        sys.exit(USAGE)
    return dry, asked


def main(argv):
    if not argv or not argv[0]:
        sys.exit(USAGE)
    directory = Path(os.path.normpath(Path.cwd() / argv[0]))
    if not directory.is_dir():
        sys.exit(f"open-session: {argv[0]}: not a directory")
    dry, asked = options(argv[1:])

    if directory.resolve() == ROOT:
        name = "orchestrator"
        args = ["-n", name]
    else:
        name = re.sub(r"^-+", "", directory.name.lower().replace(".", "-"))
        args = ["-n", name, "/0xc0:work-issue"]
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", name):
        sys.exit(f"open-session: '{name}' is not a name Herdr takes")

    try:
        picked = frontend.choose(asked)
        if not dry:
            for where in frontend.answering(picked):
                frontend.use(where)
                session = frontend.find_session(name)
                if session:
                    frontend.focus_session(session)
                    return
        frontend.use(picked)
        frontend.open_session(name, directory, args, dry)
    except (frontend.Failed, OSError) as e:
        sys.exit(f"open-session: {e}")


if __name__ == "__main__":
    main(sys.argv[1:])
