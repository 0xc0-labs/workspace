#!/usr/bin/env python3
"""A repo's autopilot: works its Ready issues, one fresh Claude Code session
per issue, each in its own tab and worktree (README.md, Autopilot).

  autopilot run <repo> [--dry-run]  the loop, in the repo's `autopilot` tab;
                                    --dry-run prints one round and changes nothing
  autopilot start <repo>            turns it on, if it is off
  autopilot toggle <repo>           turns it on or off
  autopilot state <repo>            prints on or off
  autopilot prepare <repo>          clones the repo if missing, puts it on an
                                    up-to-date main, installs its plugins;
                                    `.` for the workspace's plugins only

<repo> is the repo's directory in the workspace, or its path.

Every minute, in the Herdr workspace named after the repo's session, it
closes the tab of each session that printed its last line, and starts one
session per free slot:

  claude --permission-mode auto --settings .worktrees/.hooks.json \
    -n <session>-<n> -w <session>-<n> "/0xc0:work-issue <repo>#<n>"

It never closes a session that is working or waiting on the operator, and
turns itself off once no session runs and nothing is Ready to start.
"""
import fcntl
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

ORG = "0xc0-labs"
BOARD = 1
INTERVAL = 60
TAB = "autopilot"
HERDR = os.environ.get("HERDR_BIN_PATH", "herdr")
ROOT = Path(__file__).resolve().parents[2]
WORKTREES = ROOT / ".worktrees"
CONF = ROOT / "herdr" / "autopilot.conf"
HOOKS = ROOT / "claude-config" / "plugins" / "0xc0" / "hooks"
PRIORITY = {"P1": 1, "P2": 2, "P3": 3}
LOW_BUDGET = 500
CACHE = Path.home() / ".cache" / "0xc0"
MARKETPLACE_STAMP = CACHE / "marketplace-updated"
MARKETPLACE_FRESH = 120

QUERY = """
query($owner: String!, $name: String!) {
  rateLimit { remaining resetAt }
  repository(owner: $owner, name: $name) {
    issues(states: OPEN, first: 100) {
      nodes {
        number
        issueDependenciesSummary { blockedBy }
        projectItems(first: 5) {
          nodes {
            project { number }
            status: fieldValueByName(name: "Status") {
              ... on ProjectV2ItemFieldSingleSelectValue { name }
            }
            priority: fieldValueByName(name: "Priority") {
              ... on ProjectV2ItemFieldSingleSelectValue { name }
            }
          }
        }
      }
    }
  }
}
"""


class Failed(Exception):
    pass


def log(message):
    print(time.strftime("%H:%M:%S"), message, flush=True)


def run(*args, cwd=None):
    p = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    if p.returncode:
        raise Failed(f"{' '.join(args[:3])}: {(p.stderr or p.stdout).strip()}")
    return p.stdout


def herdr(*args):
    return json.loads(run(HERDR, *args))["result"]


def git(cwd, *args):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)


def session_name(repo):
    """The repo's session name, as open-session gives it."""
    return re.sub(r"^-+", "", repo.lower().replace(".", "-"))


def slots(repo):
    for line in CONF.read_text().splitlines():
        fields = line.split("#", 1)[0].split()
        if len(fields) == 2 and fields[0] == repo:
            return int(fields[1])
    return 1


def workspace(name):
    for w in herdr("workspace", "list")["workspaces"]:
        if w["label"] == name:
            return w["workspace_id"]
    return None


def tabs(ws):
    return herdr("tab", "list", "--workspace", ws)["tabs"] if ws else []


def autopilot_tab(name):
    return next((t for t in tabs(workspace(name)) if t["label"] == TAB), None)


def ready(repo):
    """The repo's issues a session may take, most urgent first; None when the
    API budget is too low to look."""
    out = run("mise", "exec", "--", "gh", "api", "graphql",
              "-f", f"query={QUERY}", "-f", f"owner={ORG}", "-f", f"name={repo}",
              cwd=ROOT)
    data = json.loads(out)["data"]
    budget = data["rateLimit"]
    if budget["remaining"] < LOW_BUDGET:
        log(f"GitHub API: {budget['remaining']} points left until "
            f"{budget['resetAt']}; starting nothing until then")
        return None
    found = []
    for issue in data["repository"]["issues"]["nodes"]:
        if issue["issueDependenciesSummary"]["blockedBy"]:
            continue
        for item in issue["projectItems"]["nodes"]:
            status = (item["status"] or {}).get("name")
            if item["project"]["number"] == BOARD and status == "Ready":
                priority = PRIORITY.get((item["priority"] or {}).get("name"), 9)
                found.append((priority, issue["number"]))
    return [n for _, n in sorted(found)]


def last_line(repo, n, pane):
    """The session's `work-issue: done|stopped` line, if it printed it."""
    screen = run(HERDR, "agent", "read", pane, "--source", "recent-unwrapped", "--lines", "80")
    pattern = re.compile(rf"work-issue: ((?:done|stopped) {re.escape(repo)}#{n}\b.*)$")
    for line in reversed(screen.splitlines()):
        m = pattern.search(line.strip())
        if m:
            return m.group(1)
    return None


def clean_up(d, session, dry):
    """Removes the session's worktree once nothing in it exists only here."""
    wt = WORKTREES / session
    if not wt.is_dir():
        return
    if git(wt, "status", "--porcelain").stdout.strip():
        log(f"{session}: worktree kept, it has uncommitted changes: {wt}")
        return
    git(wt, "fetch", "--prune", "--quiet", "origin")
    branch = git(wt, "symbolic-ref", "--quiet", "--short", "HEAD").stdout.strip()
    gone = bool(branch) and git(wt, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}").returncode != 0
    if gone:
        # A squash merge puts the branch's commits in main under other SHAs (#134).
        try:
            pr = json.loads(run("mise", "exec", "--", "gh", "pr", "view", branch, "--repo", f"{ORG}/{d.name}",
                                "--json", "state,headRefOid", cwd=ROOT))
        except (Failed, json.JSONDecodeError) as e:
            log(f"{session}: worktree kept, {branch} is gone from origin and its PR could not be read ({e}): {wt}")
            return
        if pr["state"] != "MERGED":
            log(f"{session}: worktree kept, {branch} is gone from origin and its PR is {pr['state']}: {wt}")
            return
        if git(wt, "merge-base", "--is-ancestor", "HEAD", pr["headRefOid"]).returncode:
            log(f"{session}: worktree kept, {branch} has commits not in its merged PR: {wt}")
            return
    elif git(wt, "merge-base", "--is-ancestor", "HEAD", f"origin/{branch or 'main'}").returncode:
        log(f"{session}: worktree kept, {branch or 'HEAD'} has commits not on origin: {wt}")
        return
    merged = ", its PR merged" if gone else ""
    if dry:
        log(f"{session}: would remove its worktree {wt}{merged}")
        return
    p = git(d, "worktree", "remove", str(wt))
    if p.returncode:
        log(f"{session}: worktree kept, {p.stderr.strip()}")
        return
    if branch:
        git(d, "branch", "--delete", "--force", branch)
    log(f"{session}: worktree removed{merged}")


def at_shell(pane):
    """Whether the pane is back at its shell, with no program in front."""
    info = herdr("pane", "process-info", "--pane", pane)["process_info"]
    return info["foreground_process_group_id"] == info["shell_pid"]


def finish(d, repo, session, n, tab, agent, pane, dry):
    """Closes a worker's tab when its session has ended; True if it did."""
    if agent is None:
        # Herdr may not have detected a session that just started.
        if pane is None or not at_shell(pane):
            return False
        reason = "its session exited"
    elif agent["agent_status"] in ("idle", "done"):
        reason = last_line(repo, n, agent["pane_id"])
        if reason is None:
            return False
    else:
        return False
    if dry:
        log(f"{repo}#{n}: {reason}; would close tab {tab['tab_id']}")
    else:
        herdr("tab", "close", tab["tab_id"])
        log(f"{repo}#{n}: {reason}; tab closed")
    clean_up(d, session, dry)
    return True


def worktree_settings():
    """Claude Code runs a plugin's WorktreeCreate too late for `-w`, so the
    hooks that place the worktree in .worktrees/ come in through --settings."""
    def hook(script):
        return [{"hooks": [{"type": "command", "command": shlex.quote(str(HOOKS / script))}]}]

    if not (HOOKS / "worktree-create.sh").is_file():
        raise Failed(f"no worktree hooks in {HOOKS}: is claude-config on main?")
    WORKTREES.mkdir(exist_ok=True)
    (WORKTREES / ".hooks.json").write_text(json.dumps({"hooks": {
        "WorktreeCreate": hook("worktree-create.sh"),
        "WorktreeRemove": hook("worktree-remove.sh"),
    }}, indent=2) + "\n")


def launch(d, repo, ws, session, n, dry):
    if (WORKTREES / session).exists():
        log(f"{repo}#{n}: not started, its worktree was kept: {WORKTREES / session}")
        return
    args = ["--permission-mode", "auto", "--settings", str(WORKTREES / ".hooks.json"),
            "-n", session, "-w", session, f"/0xc0:work-issue {repo}#{n}"]
    if dry:
        log(f"{repo}#{n}: would start, in {d}: {shlex.join(['claude', *args])}")
        return
    worktree_settings()
    # The 0xc0 plugin's SessionStart hook skips the board read on it (#130).
    pane = herdr("tab", "create", "--workspace", ws, "--cwd", str(d),
                 "--label", session, "--no-focus",
                 "--env", "OXC0_AUTOPILOT=1")["root_pane"]["pane_id"]
    # Not `agent start`: it waits for the agent to be ready for input, and a
    # session given a prompt goes straight to work (#112).
    run(HERDR, "pane", "run", pane, shlex.join(["claude", *args]))
    log(f"{repo}#{n}: started {session}")


def round_(d, repo, name, launched, dry):
    """One round; True when nothing is left: no session tab, and nothing Ready
    to start."""
    ws = workspace(name)
    if ws is None and not dry:
        raise Failed(f"no Herdr workspace named {name}")
    agents = {a["tab_id"]: a for a in herdr("agent", "list")["agents"]}
    panes = {p["tab_id"]: p["pane_id"] for p in herdr("pane", "list", "--workspace", ws)["panes"]} if ws else {}
    busy = set()
    for tab in tabs(ws):
        m = re.fullmatch(rf"{re.escape(name)}-(\d+)", tab["label"])
        if not m:
            continue
        n, agent = int(m.group(1)), agents.get(tab["tab_id"])
        if agent is not None and not agent.get("name") and not dry:
            subprocess.run([HERDR, "agent", "rename", agent["pane_id"], tab["label"]], capture_output=True)
        if not finish(d, repo, tab["label"], n, tab, agent, panes.get(tab["tab_id"]), dry):
            busy.add(n)
    free = slots(repo) - len(busy)
    if free <= 0:
        return False
    found = ready(repo)
    if found is None:
        return False
    todo = [n for n in found if n not in busy and n not in launched][:free]
    if todo and dry:
        log(f"{repo}: would update 0xc0")
    elif todo:
        update_plugin(d)
    for n in todo:
        launch(d, repo, ws, f"{name}-{n}", n, dry)
        launched.add(n)
    return not busy and not todo


def prepare(d):
    """Gets the clone ready for its sessions. It stays at its path, which
    holds every worktree session's plugin records, memory and approvals."""
    if d != ROOT:
        if not (d / ".git").is_dir():
            log(f"{d.name}: cloning {ORG}/{d.name}")
            run("mise", "exec", "--", "gh", "repo", "clone", f"{ORG}/{d.name}", str(d), cwd=ROOT)
        to_main(d)
    plugins(d)


def to_main(d):
    """Puts the clone on an up-to-date main, unless a branch origin still has,
    or uncommitted work, says someone works in it."""
    git(d, "fetch", "--prune", "--quiet", "origin")
    branch = git(d, "branch", "--show-current").stdout.strip()
    if branch != "main":
        track = git(d, "for-each-ref", "--format=%(upstream:track)", f"refs/heads/{branch}").stdout.strip()
        if not branch or track != "[gone]":
            log(f"{d.name}: clone left on {branch or 'a detached HEAD'}")
            return
        if git(d, "status", "--porcelain").stdout.strip():
            log(f"{d.name}: clone left on {branch}, it has uncommitted changes")
            return
        p = git(d, "switch", "--quiet", "main")
        if p.returncode:
            log(f"{d.name}: clone left on {branch}: {p.stderr.strip()}")
            return
    p = git(d, "pull", "--ff-only", "--quiet")
    if p.returncode:
        log(f"{d.name}: main not updated: {p.stderr.strip()}")


def claude_plugin(d, *args):
    p = subprocess.run(["claude", "plugin", *args], cwd=d, capture_output=True, text=True)
    if p.returncode:
        log(f"{d.name}: claude plugin {' '.join(args)}: {(p.stderr or p.stdout).strip()}")
    return p.returncode == 0


def plugins(d):
    """Installs the plugins the repo enables that have no record for its path
    (#106), then updates 0xc0."""
    settings = d / ".claude" / "settings.json"
    installed = json.loads(run("claude", "plugin", "list", "--json", cwd=d))
    for plugin, on in json.loads(settings.read_text()).get("enabledPlugins", {}).items():
        if on and not any(i["id"] == plugin and (i.get("scope") == "user" or i.get("projectPath") == str(d))
                          for i in installed):
            log(f"{d.name}: installing {plugin}")
            claude_plugin(d, "install", plugin, "--scope", "local")
    update_plugin(d)


def update_plugin(d):
    """Updates 0xc0, which Claude Code would update only after a session had
    started on the old one (#114): a session loads the install on disk when
    it starts (#124)."""
    settings = d / ".claude" / "settings.json"
    CACHE.mkdir(parents=True, exist_ok=True)
    # Several autopilots share one marketplace clone, ~/.claude/plugins/marketplaces/0xc0-labs, and concurrent updates break it (#132).
    with open(CACHE / "plugin-update.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        before = settings.read_text()
        if not marketplace_fresh() and claude_plugin(d, "marketplace", "update", "0xc0-labs"):
            MARKETPLACE_STAMP.touch()
        claude_plugin(d, "update", "0xc0@0xc0-labs")
        after = settings.read_text()
        if after != before and json.loads(after) == json.loads(before):
            settings.write_text(before)  # a project-scope update rewrites it with its keys reordered


def marketplace_fresh():
    try:
        return time.time() - MARKETPLACE_STAMP.stat().st_mtime < MARKETPLACE_FRESH
    except FileNotFoundError:
        return False


def loop(d, dry):
    repo, name = d.name, session_name(d.name)
    log(f"{repo}: " + ("dry run" if dry else "autopilot on") + f", {slots(repo)} at a time")
    if not dry:
        prepare(d)
    launched = set()
    while True:
        done = False
        try:
            done = round_(d, repo, name, launched, dry)
        except (Failed, json.JSONDecodeError, KeyError) as e:
            log(f"error: {e}")
        if dry:
            return
        if done:
            log(f"{repo}: nothing Ready and no session running; autopilot off")
            tab = autopilot_tab(name)
            if tab and tab["tab_id"] == os.environ.get("HERDR_TAB_ID"):
                herdr("tab", "close", tab["tab_id"])
            return
        time.sleep(INTERVAL)


def toggle(d):
    tab = autopilot_tab(session_name(d.name))
    if tab:
        herdr("tab", "close", tab["tab_id"])
        print(f"{d.name}: autopilot off")
    else:
        turn_on(d)


def start(d):
    if autopilot_tab(session_name(d.name)):
        print(f"{d.name}: autopilot already on")
    else:
        turn_on(d)


def turn_on(d):
    repo, name = d.name, session_name(d.name)
    command = f"{shlex.quote(str(Path(__file__).resolve()))} run {shlex.quote(str(d))}"
    env = ["--env", f"HERDR_BIN_PATH={HERDR}"]
    cwd = str(d if d.is_dir() else ROOT)  # run clones a repo that is not here yet
    ws = workspace(name)
    if ws:
        pane = herdr("tab", "create", "--workspace", ws, "--cwd", cwd,
                     "--label", TAB, "--no-focus", *env)["root_pane"]["pane_id"]
    else:
        created = herdr("workspace", "create", "--cwd", cwd, "--label", name, "--no-focus", *env)
        herdr("tab", "rename", created["tab"]["tab_id"], TAB)
        pane = created["root_pane"]["pane_id"]
    run(HERDR, "pane", "run", pane, command)  # prints nothing on success, unlike the rest
    print(f"{repo}: autopilot on")


def main(argv):
    if len(argv) < 2 or argv[0] not in ("run", "start", "toggle", "state", "prepare"):
        sys.exit(__doc__.strip().split("\n\n")[1])
    d = Path(os.path.normpath(ROOT / argv[1]))
    if not (d.parent == ROOT and re.fullmatch(r"[A-Za-z0-9._-]+", d.name)
            or argv[0] == "prepare" and d == ROOT):
        sys.exit(f"autopilot: {d} is not a repo of the workspace")
    if argv[0] == "prepare":
        prepare(d)
    elif argv[0] == "run":
        loop(d, "--dry-run" in argv[2:])
    elif argv[0] == "start":
        start(d)
    elif argv[0] == "toggle":
        toggle(d)
    else:
        print("on" if autopilot_tab(session_name(d.name)) else "off")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        log("autopilot off")
    except Failed as e:
        sys.exit(f"autopilot: {e}")
