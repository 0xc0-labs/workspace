#!/usr/bin/env python3
"""A repo's autopilot: works its Ready issues, one fresh Claude Code session
per issue, each in its own tab and worktree (README.md, Autopilot).

  autopilot run <repo> [--dry-run] [--frontend tui|app]
                                    the loop, in the repo's `autopilot` tab;
                                    --dry-run prints one round and changes nothing
  autopilot start <repo> [--frontend tui|app]
                                    turns it on, if it is off
  autopilot toggle <repo> [--frontend tui|app]
                                    turns it on or off
  autopilot state <repo> [--frontend tui|app]
                                    prints on, off, or dead (a tab whose loop
                                    exited; `start` restarts it)
  autopilot prepare <repo>          clones the repo if missing, puts it on an
                                    up-to-date main, installs its plugins,
                                    trusts it in Claude Code; `.` for the
                                    workspace's plugins and trust only
  autopilot --self-test             checks how the last line is recognised, when
                                    a session at rest is closed, the front ends
                                    and the app backend

<repo> is the repo's directory in the workspace, or its path. The front end is
the one asked for, with --frontend or OXC0_HERDR_FRONTEND; else the one this
runs in; else the app if its window answers, and the TUI if not (README.md,
Which front end). `start`, `toggle` and `state` also look in every other front
end that answers, and a repo never has two autopilots.

Every minute, in the space of the front end in use named after the repo's
session, it closes the tab of each session that printed its last line, or is at
rest with its issue closed, and starts one session per free slot:

  claude --permission-mode auto --settings .worktrees/.hooks.json \
    -n <session>-<n> -w <session>-<n> "/0xc0:work-issue <repo>#<n>"

It never closes a session that is working or waiting on the operator, and
turns itself off once no session runs and a fresh read of the board shows
nothing Ready for the repo. Between rounds it re-executes itself when its own
code changed.
"""
import collections
import contextlib
import fcntl
import io
import json
import os
import re
import shlex
import socket
import stat
import subprocess
import sys
import tempfile
import time
import types
from pathlib import Path

ORG = "0xc0-labs"
MARKETPLACE = "0xc0-labs"
BOARD = 1
INTERVAL = 60
ROOT = Path(__file__).resolve().parents[2]
LIB = ROOT / "herdr" / "lib"
WORKTREES = ROOT / ".worktrees"
CONF = ROOT / "herdr" / "autopilot.conf"
HOOKS = ROOT / "claude-config" / "plugins" / "0xc0" / "hooks"
PRIORITY = {"P1": 1, "P2": 2, "P3": 3}
LOW_BUDGET = 500
CACHE = Path.home() / ".cache" / "0xc0"
MARKETPLACE_STAMP = CACHE / "marketplace-updated"
MARKETPLACE_FRESH = 120
CLAUDE_JSON = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home()) / ".claude.json"
# Claude Code's own new project entry: it reads one without filling in the keys it lacks.
NEW_PROJECT = {"allowedTools": [], "mcpContextUris": [], "mcpServers": {},
               "enabledMcpjsonServers": [], "disabledMcpjsonServers": [],
               "hasTrustDialogAccepted": False, "hasClaudeMdExternalIncludesApproved": False,
               "hasClaudeMdExternalIncludesWarningShown": False}
CONFIG_LOCK_STALE = 10
SCRIPT = Path(__file__).resolve()
FRONTEND = LIB / "frontend"
LAUNCHED_ENV = "OXC0_AUTOPILOT_LAUNCHED"
KEPT_REPEAT = 600

sys.dont_write_bytecode = True  # importing the layer would leave a __pycache__ in the checkout
sys.path.insert(0, str(LIB))
import frontend  # noqa: E402
from frontend import Failed  # noqa: E402

USAGE = __doc__.strip().split("\n\n")[1]

QUERY = """
query($owner: String!, $name: String!) {
  rateLimit { remaining resetAt }
  repository(owner: $owner, name: $name) {
    issues(states: OPEN, first: 100) {
      pageInfo { hasNextPage }
      nodes {
        number
        issueDependenciesSummary { blockedBy }
        projectItems(first: 5) {
          nodes {
            project { number }
            updatedAt
            status: fieldValueByName(name: "Status") {
              ... on ProjectV2ItemFieldSingleSelectValue { name }
            }
            priority: fieldValueByName(name: "Priority") {
              ... on ProjectV2ItemFieldSingleSelectValue { name }
            }
          }
        }
      }
    }
  }
}
"""


def log(message):
    print(time.strftime("%H:%M:%S"), message, flush=True)


def run(*args, cwd=None):
    p = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    if p.returncode:
        raise Failed(f"{' '.join(args[:3])}: {(p.stderr or p.stdout).strip()}")
    return p.stdout


def git(cwd, *args):
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)


def session_name(repo):
    """The repo's session name, as open-session gives it."""
    return re.sub(r"^-+", "", repo.lower().replace(".", "-"))


def slots(repo):
    for line in CONF.read_text().splitlines():
        fields = line.split("#", 1)[0].split()
        if len(fields) == 2 and fields[0] == repo:
            return int(fields[1])
    return 1


Board = collections.namedtuple("Board", "ready still_open")


def read_board(repo):
    """What a round reads of the repo's board, in one request: a Board whose
    `ready` is the repo's issues a session may take, most urgent first, as
    (number, time its board item last changed), and whose `still_open` is the
    set of the repo's open issues, or None when the list is cut short and so
    cannot say an issue is closed. None when the API budget is too low to look."""
    out = run("mise", "exec", "--", "gh", "api", "graphql",
              "-f", f"query={QUERY}", "-f", f"owner={ORG}", "-f", f"name={repo}",
              cwd=ROOT)
    data = json.loads(out)["data"]
    budget = data["rateLimit"]
    if budget["remaining"] < LOW_BUDGET:
        log(f"GitHub API: {budget['remaining']} points left until "
            f"{budget['resetAt']}; starting nothing until then")
        return None
    issues = data["repository"]["issues"]
    found = []
    for issue in issues["nodes"]:
        if issue["issueDependenciesSummary"]["blockedBy"]:
            continue
        for item in issue["projectItems"]["nodes"]:
            status = (item["status"] or {}).get("name")
            if item["project"]["number"] == BOARD and status == "Ready":
                priority = PRIORITY.get((item["priority"] or {}).get("name"), 9)
                found.append((priority, issue["number"], item["updatedAt"]))
    complete = not issues["pageInfo"]["hasNextPage"]
    return Board([(n, at) for _, n, at in sorted(found)],
                 {issue["number"] for issue in issues["nodes"]} if complete else None)


def find_last_line(repo, n, screen):
    """The `done|stopped` line alone on a screen line, searched from the bottom."""
    pattern = re.compile(rf"(?:done {re.escape(repo)}#{n}|stopped {re.escape(repo)}#{n}: \S.*)")
    for line in reversed(screen.splitlines()):
        text = line.strip().removeprefix("\u23fa").strip()
        m = re.fullmatch(r"work-issue: (.+)", text)
        if m and pattern.fullmatch(m.group(1)):
            return m.group(1)
    return None


def last_line(repo, n, session):
    """The session's `work-issue: done|stopped` line, if it printed it."""
    return find_last_line(repo, n, frontend.read_screen(session))


def asks(installed=("tui", "app"), window=False, core=()):
    """The answers of fake front ends, in the form `frontend.choose` and
    `frontend.answering` ask for them."""
    def ask(name, question):
        if question == "missing":
            return [] if name in installed else [f"{name}-program"]
        if question == "shows":
            assert name in installed, "asked whether a front end that is not installed shows"
            return window
        return name in core
    return ask


def outcome(function, *args):
    try:
        return function(*args)
    except (Failed, AssertionError) as e:
        return f"failed: {e}"


def play(app, recorded, action):
    """Runs `action` with the app backend's `hc` and `herdr-app` calls
    answered from `recorded`, command line to (exit status, stdout), with a
    third item for its stderr when it has one, or a list of them taken in turn,
    the last one repeating. Returns the command lines it ran, what it printed
    and what it returned."""
    ran, out = [], io.StringIO()

    def call(*command):
        line = shlex.join(command)
        ran.append(line)
        answer = recorded.get(line, (99, f"no recorded answer for {line}"))
        if isinstance(answer, list):
            answer = answer.pop(0) if len(answer) > 1 else answer[0]
        return subprocess.CompletedProcess(command, answer[0], answer[1], answer[2] if len(answer) > 2 else "")

    saved = app.call, app.PAUSE
    app.call, app.PAUSE = call, 0
    try:
        with contextlib.redirect_stdout(out):
            result = outcome(action)
    finally:
        app.call, app.PAUSE = saved
    return ran, out.getvalue(), result


def core_cases(app):
    """(what, got, want) for where the app backend looks for the core's socket
    and for whether it answers there, from temporary files: no core runs."""
    cases = []
    home, state = "/home/op", "/home/op/.local/state/herdr-core"
    nowhere = "/nonexistent-run"
    # A socket's path may be 103 bytes at most on macOS, and $TMPDIR may be long.
    with tempfile.TemporaryDirectory(dir="/tmp", prefix="hc") as tmp:
        config = Path(tmp) / "herdr-core" / "config.toml"
        config.parent.mkdir()
        runtime = Path(tmp) / "run"
        (runtime / "herdr-core").mkdir(parents=True)
        socket_rows = [
            ("HC_SOCKET wins", {"HC_SOCKET": "/x/a.sock", "XDG_RUNTIME_DIR": "/run/u"}, nowhere, "/x/a.sock"),
            ("an empty HC_SOCKET is not set", {"HC_SOCKET": ""}, nowhere, f"{state}/default/default.sock"),
            ("the state directory, by default", {}, nowhere, f"{state}/default/default.sock"),
            ("XDG_STATE_HOME", {"XDG_STATE_HOME": "/st"}, nowhere, "/st/herdr-core/default/default.sock"),
            ("HC_SESSION", {"HC_SESSION": "work"}, nowhere, f"{state}/work/work.sock"),
            ("XDG_RUNTIME_DIR", {"XDG_RUNTIME_DIR": "/run/u", "HC_SESSION": "work"}, nowhere,
             "/run/u/herdr-core/work.sock"),
            ("/run/user/<uid>, when it is a directory", {}, str(runtime), f"{runtime}/herdr-core/default.sock"),
            ("XDG_RUNTIME_DIR wins over /run/user/<uid>", {"XDG_RUNTIME_DIR": "/run/u"}, str(runtime),
             "/run/u/herdr-core/default.sock"),
        ]
        for what, environ, run_user, want in socket_rows:
            cases.append((f"core socket: {what}", app.core_socket({"HOME": home, **environ}, run_user), want))
        configs = [
            ("a top-level socket", 'socket = "/c/core.sock"\n', "/c/core.sock"),
            ("single quotes and a comment", "  socket = '/c/core.sock'  # mine\n", "/c/core.sock"),
            ("after other keys", 'notes = false\nsocket = "/c/core.sock"\n', "/c/core.sock"),
            ("a commented line", '# socket = "/c/core.sock"\n', None),
            ("a key of a table", '[machines]\nsocket = "/c/core.sock"\n', None),
            ("an empty value", 'socket = ""\n', None),
            ("another key that ends in socket", 'x_socket = "/c/core.sock"\n', None),
        ]
        for what, text, want in configs:
            config.write_text(text)
            environ = {"HOME": home, "XDG_CONFIG_HOME": tmp, "XDG_RUNTIME_DIR": "/run/u"}
            cases.append((f"core socket, config file: {what}", app.core_socket(environ, nowhere),
                          want or "/run/u/herdr-core/default.sock"))
        config.unlink()
        cases.append(("core socket: no config file", app.core_socket({"HOME": home, "XDG_CONFIG_HOME": tmp}, nowhere),
                      f"{state}/default/default.sock"))

        path = f"{tmp}/core.sock"

        def answers():
            saved = os.environ.get("HC_SOCKET")
            os.environ["HC_SOCKET"] = path
            try:
                return play(app, {}, app.answers)
            finally:
                if saved is None:
                    del os.environ["HC_SOCKET"]
                else:
                    os.environ["HC_SOCKET"] = saved

        cases.append(("core answers: no socket there, and no command run", answers(), ([], "", False)))
        listener = socket.socket(socket.AF_UNIX)
        try:
            listener.bind(path)
            listener.listen(1)
            cases.append(("core answers: a socket somebody listens on", answers(), ([], "", True)))
        finally:
            listener.close()
        cases.append(("core answers: the file is still there", os.path.exists(path), True))
        cases.append(("core answers: a socket file a closed listener left behind", answers(), ([], "", False)))
    return cases


SCREEN = "THE-WHOLE-TEXT-OF-A-TERMINAL"


def app_autopilot_cases(app):
    """(what, got, want) for the app backend's operations of the autopilot,
    with `hc` and `herdr-app` answered from the shapes below: nothing runs.

    Recorded from the real programs (0xc0-labs/workspace#226, #231): the rows
    of `hc ls --all`, `hc run`'s answer, `hc rm`'s `{"removed": …}`, `hc get`'s
    fields (`foreground`, `keep`, `rm`, `parent`, `notify`, `labels`) and the
    shape of `hc wait`'s and `hc read`'s answers. Stand-ins, never seen from
    the programs because they take restarting the core: the `hc get` of a
    session left as a shell, built from `hc schema`, and `hc kill`'s answer,
    which the backend does not read."""
    cases = []
    session = app.Session("t7", "gitops-19", {})
    tab, ended = app.Tab("t7", "gitops-19", True), app.Tab("t8", "gitops-21", False)

    def plays(what, recorded, action, ran, printed, result):
        cases.append((f"app autopilot: {what}", play(app, recorded, action), (ran, printed, result)))

    def row(**fields):
        return {"address": "t7", "agent": "claude-code", "cwd": "/ws/gitops", "name": "gitops-19",
                "state": "live", "turn": 0, **fields}

    def ls(*rows):
        return 0, json.dumps({"hidden_finished": 0, "terminals": list(rows)})

    def terminal(foreground=None):
        return 0, json.dumps({"address": "t7", "argv": ["env", "OXC0_AUTOPILOT=1", "claude"], "keep": True,
                              "labels": {"oxc0.role": "worker", "herdr.seen": "0"}, "name": "gitops-19",
                              "notify": False, "parent": None, "rm": False, "state": "live", "turn": 0,
                              "screen": SCREEN, **({"foreground": foreground} if foreground else {})})

    claude = ["claude", "--permission-mode", "auto", "-n", "gitops-19", "-w", "gitops-19",
              "/0xc0:work-issue gitops#19"]
    get = "hc get t7 --json"
    not_found = (3, '{"error":{"kind":"not_found","message":"t7 was removed"}}')

    plays("a space is there as soon as it has a name", {}, lambda: app.find_space("gitops"), [], "",
          app.Space("gitops"))

    # The sessions of a space.
    listed = "hc ls --all --label oxc0.space=gitops --label oxc0.role=worker --json"
    plays("the sessions of a space: one per terminal named after an issue, finished ones included",
          {listed: ls(row(status="working", turn=1),
                      row(address="t8", name="gitops-21", state="finished", exit_code=129, reason="killed", turn=1),
                      row(address="t9", name=None), row(address="t10", name="gitops-x"),
                      row(address="t11", name="other-3"))},
          lambda: [(w.n, w.name, str(w.tab), w.tab.live, w.session.address)
                   for w in app.workers(app.find_space("gitops"))],
          [listed], "", [(19, "gitops-19", "t7", True, "t7"), (21, "gitops-21", "t8", False, "t8")])
    plays("no sessions", {listed: ls()}, lambda: list(app.workers(app.find_space("gitops"))), [listed], "", [])
    plays("an answer without a list of terminals", {listed: (0, "{}")},
          lambda: list(app.workers(app.find_space("gitops"))), [listed], "",
          "failed: hc ls: its answer has no list of terminals")

    # A session's state, row by row of the table in README.md, In the app.
    shell = {"argv": ["-zsh"], "cwd": "/ws/gitops", "name": "zsh", "pid": 4300}
    states = [
        ("finished: its program exited", dict(state="finished", exit_code=0, reason="exited", turn=1), False,
         frontend.ENDED),
        ("finished: it was killed", dict(state="finished", exit_code=129, reason="killed", turn=1), False,
         frontend.ENDED),
        ("turn 0, idle at its startup: not at rest", dict(status="idle"), False, frontend.BUSY),
        ("turn 0, done: not at rest", dict(status="done"), False, frontend.BUSY),
        ("turn 0, working", dict(status="working"), False, frontend.BUSY),
        ("turn 0, blocked at the trust question", dict(status="blocked"), False, frontend.BUSY),
        ("turn 1, idle: at rest", dict(status="idle", turn=1), False, frontend.AT_REST),
        ("turn 1, done: at rest", dict(status="done", turn=1), False, frontend.AT_REST),
        ("turn 3, done: at rest", dict(status="done", turn=3), False, frontend.AT_REST),
        ("turn 1, working", dict(status="working", turn=1), False, frontend.BUSY),
        ("turn 1, blocked on a permission", dict(status="blocked", turn=1), False, frontend.BUSY),
        ("turn 1, an error", dict(status="error", turn=1), False, frontend.BUSY),
        ("starting, nothing reported yet: Claude Code in front", dict(), {"argv": claude}, frontend.BUSY),
        ("starting, nothing reported yet: env in front, about to become it",
         dict(), {"argv": ["env", "OXC0_AUTOPILOT=1", *claude]}, frontend.BUSY),
        ("nothing reported, Claude Code under its program's name alone",
         dict(turn=1), {"argv": ["claude"], "name": "node"}, frontend.BUSY),
        ("nothing reported, no `foreground` in the answer", dict(), None, frontend.BUSY),
        ("nothing reported, a `foreground` without a command line", dict(), {"name": "zsh"}, frontend.BUSY),
        ("left as a shell at turn 0: its program is gone", dict(), shell, frontend.ENDED),
        ("left as a shell at turn 1: its program is gone", dict(turn=1), shell, frontend.ENDED),
        ("left as a shell, whose path is absolute", dict(), {"argv": ["/bin/zsh", "-l"]}, frontend.ENDED),
    ]
    for what, fields, foreground, want in states:
        asked = foreground is not False
        plays(f"a session's state, {what}", {get: terminal(foreground or None)} if asked else {},
              lambda fields=fields: app.session_state(app.Session("t7", "gitops-19", row(**fields))),
              [get] if asked else [], "", want)
    plays("a session whose state cannot be read", {get: not_found},
          lambda: app.session_state(app.Session("t7", "gitops-19", row())), [get], "",
          "failed: hc get: not_found: t7 was removed")

    # What `hc get` and `hc read` answer is a terminal's text: it goes nowhere.
    leaked = play(app, {get: terminal(shell)}, lambda: app.session_state(app.Session("t7", "gitops-19", row())))
    cases.append(("the screen hc get answers is dropped and goes nowhere", SCREEN in repr(leaked), False))
    plays("hc get answering what is not JSON says nothing of it", {get: (0, f"{SCREEN} is not JSON")},
          lambda: app.session_state(app.Session("t7", "gitops-19", row())), [get], "",
          "failed: hc get: its answer is not JSON")
    read = "hc read t7 --json --lines 80"
    screen = "\n".join(["Opened the PR.", "⏺ work-issue: done gitops#19", "", "> "])
    answer = (0, json.dumps({"complete": True, "how": "stitched", "text": screen}))
    plays("a session's last lines: the text of hc read's answer", {read: answer},
          lambda: app.read_screen(session), [read], "", screen)
    plays("hc read answering what is not JSON says nothing of it", {read: (0, f"{SCREEN} is not JSON")},
          lambda: app.read_screen(session), [read], "", "failed: hc read: its answer is not JSON")
    plays("hc read answering without text", {read: (0, '{"complete":true,"how":"screen"}')},
          lambda: app.read_screen(session), [read], "", "failed: hc read: its answer has no text")

    # A call that fails says its `error`, else its exit status and nothing it
    # wrote: that may be a terminal's text, which would reach the loop's log.
    not_found_error = '{"error":{"kind":"not_found","message":"t7 was removed"}}'
    failures = [
        ("text cut off", (5, f'{{"address":"t7","screen":"{SCREEN}'), "exit status 5"),
        ("a whole answer with no `error`", (1, json.dumps({"address": "t7", "screen": SCREEN, "text": SCREEN})),
         "exit status 1"),
        ("text on stderr", (2, "", SCREEN), "exit status 2"),
        ("an `error` and the text", (3, json.dumps({**json.loads(not_found_error), "screen": SCREEN, "text": SCREEN})),
         "not_found: t7 was removed"),
        ("an `error` on stderr", (3, SCREEN, not_found_error), "not_found: t7 was removed"),
    ]
    for what, reply, said in failures:
        for call_, line, action in (
                ("hc get", get, lambda: app.session_state(app.Session("t7", "gitops-19", row()))),
                ("hc read", read, lambda: app.read_screen(session))):
            plays(f"{call_} failing with {what} says {said}", {line: reply}, action, [line], "",
                  f"failed: {call_}: {said}")
    plays("a command that is not a terminal's text still says what it wrote",
          {"hc rm t7": (1, "", "t7: cannot be removed")}, lambda: app.remove("t7"), ["hc rm t7"], "",
          "failed: hc rm: t7: cannot be removed")
    read_back = play(app, {read: answer}, lambda: app.read_screen(session))[2]
    last_lines = [
        ("done", read_back, "done gitops#19"),
        ("stopped", "⏺ work-issue: stopped gitops#19: checks red\n> ", "stopped gitops#19: checks red"),
        ("a sentence that quotes it", "I will print `work-issue: done gitops#19` when it is merged.", None),
    ]
    for what, text, want in last_lines:
        cases.append((f"the last line, from a recorded hc read answer: {what}",
                      find_last_line("gitops", 19, text), want))

    # Ending a session: its screen is read before, never after.
    kill, wait, rm = "hc kill t7", "hc wait t7 --timeout 10 --json", "hc rm t7"
    killed = (0, '{"address":"t7","state":"finished","reason":"killed","exit_code":129,"turn":1}')
    waited = (0, '{"ended":true,"exit_code":129,"reason":"exit","status":null,"turn":1}')
    removed = (0, '{"removed":"t7"}')
    plays("a live session ends with kill, wait and rm", {kill: killed, wait: waited, rm: removed},
          lambda: app.close_tab(tab), [kill, wait, rm], "", None)
    plays("a finished session is only removed", {"hc rm t8": (0, '{"removed":"t8"}')},
          lambda: app.close_tab(ended), ["hc rm t8"], "", None)
    plays("a session that does not end is not removed and not waited for for ever",
          {kill: killed, wait: (0, '{"ended":false,"reason":"timeout","turn":1}'), rm: removed},
          lambda: app.close_tab(tab), [kill, wait], "", "failed: gitops-19 did not end 10 seconds after hc kill")
    plays("a session already gone is not an error", {kill: not_found},
          lambda: app.close_tab(tab), [kill], "", None)
    plays("a session removed meanwhile is not an error", {kill: killed, wait: waited, rm: not_found},
          lambda: app.close_tab(tab), [kill, wait, rm], "", None)
    plays("hc rm refusing a terminal that is live says so",
          {kill: killed, wait: waited, rm: (4, '{"error":{"kind":"live","message":"t7 is live"}}')},
          lambda: app.close_tab(tab), [kill, wait, rm], "", "failed: hc rm: live: t7 is live")
    plays("a dry run prints the commands and runs none of them", {},
          lambda: app.close_tab(tab, dry=True), [], f"{kill}\n{wait}\n{rm}\n", None)
    plays("a dry run on a finished session prints the removal", {},
          lambda: app.close_tab(ended, dry=True), [], "hc rm t8\n", None)

    # Starting a session.
    command = shlex.join(["claude", "--permission-mode", "auto", "--settings", "/ws/.worktrees/.hooks.json",
                          "-n", "gitops-19", "-w", "gitops-19", "/0xc0:work-issue gitops#19"])
    start = ("hc run --bg --keep --no-parent --no-notify --json --name gitops-19 --cwd /ws/gitops "
             "--label herdr.space=oxc0-gitops --label herdr.tab=oxc0-gitops-19 "
             "--label oxc0.space=gitops --label oxc0.role=worker --label oxc0.issue=19 "
             "-- env OXC0_AUTOPILOT=1 claude --permission-mode auto --settings /ws/.worktrees/.hooks.json "
             "-n gitops-19 -w gitops-19 '/0xc0:work-issue gitops#19'")
    started = (0, '{"address":"t7","agent":"claude","cwd":"/ws/gitops","name":"gitops-19","state":"live","turn":0}')
    status, ok = "herdr-app status", (0, '{"ok": true}')
    not_shown = (1, '{"error": "no such space"}')
    space, tab_rename = ("herdr-app do space.rename --id oxc0-gitops --name gitops",
                         "herdr-app do tab.rename --id oxc0-gitops-19 --name gitops-19")

    def begin(**more):
        return lambda: app.start_session(app.Space("gitops"), "gitops-19", "/ws/gitops", command,
                                         {"OXC0_AUTOPILOT": "1"}, **more)

    plays("a session starts with its command in the terminal's creation, then is named, retried until shown",
          {status: (0, "{}"), start: started, space: [not_shown, ok], tab_rename: ok},
          begin(), [status, start, space, space, tab_rename], "", None)
    plays("a session starts when the window does not answer, and nothing else differs",
          {status: (2, ""), start: started}, begin(), [status, start], "", None)
    plays("a window that never shows the terminal is said, not an error",
          {status: (0, "{}"), start: started, space: not_shown}, begin(),
          [status, start] + [space] * app.ATTEMPTS,
          "gitops-19 started as t7, but the window did not show it to name it: no such space\n", None)
    plays("a dry run with the window prints the commands and runs none of them", {status: (0, "{}")},
          begin(dry=True), [status], "\n".join([start, space, tab_rename]) + "\n", None)
    plays("a dry run without the window prints the session's command", {status: (2, "")},
          begin(dry=True), [status], start + "\n# the app's window does not answer: nothing to name\n", None)
    plays("a name a live terminal has is said", {
        status: (2, ""), start: (4, '{"error":{"kind":"name_taken","message":"gitops-19 is taken"}}')},
          begin(), [status, start], "", "failed: hc run: name_taken: gitops-19 is taken")
    plays("a name that is not an issue's of the space", {},
          lambda: app.start_session(app.Space("gitops"), "other-3", "/ws/gitops", command, {}), [], "",
          "failed: other-3 is not a session of gitops: its name is gitops-<issue>")
    plays("a session with no variables has no env in front",
          {status: (2, ""), start.replace("env OXC0_AUTOPILOT=1 ", ""): started},
          lambda: app.start_session(app.Space("gitops"), "gitops-19", "/ws/gitops", command, {}),
          [status, start.replace("env OXC0_AUTOPILOT=1 ", "")], "", None)

    # The pilot's loop.
    pilot_ls = "hc ls --all --label oxc0.space=gitops --label oxc0.role=autopilot --json"
    loop = shlex.join(["/ws/my herdr/bin/autopilot", "run", "/ws/gitops"])
    start_loop = ("hc run --bg --no-parent --no-notify --json --name gitops-autopilot --cwd /ws/gitops "
                  "--label herdr.space=oxc0-gitops --label herdr.tab=oxc0-gitops-autopilot "
                  "--label oxc0.space=gitops --label oxc0.role=autopilot "
                  "-- env OXC0_HERDR_FRONTEND=app '/ws/my herdr/bin/autopilot' run /ws/gitops")
    loop_started = (0, '{"address":"t3","agent":"python3","cwd":"/ws/gitops","name":"gitops-autopilot",'
                       '"state":"live","turn":0}')
    loop_tab = "herdr-app do tab.rename --id oxc0-gitops-autopilot --name autopilot"
    plays("a pilot's loop starts with the front end in its command, then is named", {
        status: (0, "{}"), start_loop: loop_started, space: ok, loop_tab: ok},
          lambda: app.start_pilot("gitops", "/ws/gitops", loop), [status, start_loop, space, loop_tab], "", None)
    plays("a pilot's loop starts when the window does not answer", {status: (2, ""), start_loop: loop_started},
          lambda: app.start_pilot("gitops", "/ws/gitops", loop), [status, start_loop], "", None)

    # The pilot's state, row by row of the table in README.md, In the app.
    def found():
        tab_found = app.pilot("gitops")
        return (str(tab_found), app.pilot_alive(tab_found)) if tab_found else None

    def loop_row(**fields):
        return row(**{"address": "t3", "name": "gitops-autopilot", **fields})

    # `hc get` of a loop, as recorded on 2026-11-17 (hc 0.1.21): `keep` is true
    # though the loop was started without `--keep`.
    loop_get = "hc get t3 --json"
    interpreter = ("/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/"
                   "Resources/Python.app/Contents/MacOS/Python")
    running = {"argv": [interpreter, "/ws/herdr/bin/autopilot", "run", "/ws/gitops"]}

    def loop_terminal(foreground=None):
        return 0, json.dumps({"address": "t3", "name": "gitops-autopilot", "keep": True, "rm": False,
                              "parent": None, "notify": False, "screen": SCREEN,
                              "labels": {"herdr.space": "oxc0-gitops", "herdr.tab": "oxc0-gitops-autopilot",
                                         "oxc0.role": "autopilot", "oxc0.space": "gitops"},
                              **({"foreground": foreground} if foreground else {})})

    gone = dict(state="finished", turn=0)
    pilot_rows = [
        ("a live one: on", [loop_row(status="working", turn=1)], ("t3", True), [], running),
        ("a live one that has not reported yet: on", [loop_row()], ("t3", True), [], running),
        ("none live, one finished with exit 0: off, and it is removed",
         [loop_row(**gone, exit_code=0, reason="exited")], None, ["hc rm t3"], False),
        ("none live, one finished with another exit code: dead",
         [loop_row(**gone, exit_code=129, reason="killed")], ("t3", False), [], False),
        ("none live, one finished with no exit code: dead",
         [loop_row(**gone, reason="signaled")], ("t3", False), [], False),
        ("none: off", [], None, [], False),
        ("one live and an older one that exited with 0: on, and the old one is removed",
         [loop_row(address="t2", **gone, exit_code=0, reason="exited"), loop_row(status="idle", turn=1)],
         ("t3", True), ["hc rm t2"], running),
        ("one that exited with 0 and one that did not: dead, and the first is removed",
         [loop_row(address="t2", **gone, exit_code=0, reason="exited"),
          loop_row(**gone, exit_code=1, reason="exited")], ("t3", False), ["hc rm t2"], False),
    ]
    for what, rows, want, more, front in pilot_rows:
        asked = front is not False
        recorded = {pilot_ls: ls(*rows), **{removal: (0, '{"removed":"t"}') for removal in more},
                    **({loop_get: loop_terminal(front)} if asked else {})}
        plays(f"a pilot's state, {what}", recorded, found, [pilot_ls, *more, *([loop_get] if asked else [])], "",
              want)

    # A live terminal is on only while the loop is what runs in front of it.
    other_checkout = {"argv": [interpreter, "/other/ws/herdr/bin/autopilot", "run", "/ws/gitops"]}
    env_in_front = {"argv": ["env", "OXC0_HERDR_FRONTEND=app", "/ws/herdr/bin/autopilot", "run", "/ws/gitops"]}
    shebang_env = {"argv": ["/usr/bin/env", "python3", "/ws/herdr/bin/autopilot", "run", "/ws/gitops"]}
    in_front = [
        ("the loop in front", running, True),
        ("the loop started from another checkout", other_checkout, True),
        ("env in front, a moment after start", env_in_front, True),
        ("env of the loop's shebang in front", shebang_env, True),
        ("no `foreground` yet, a moment after start", None, True),
        ("a `foreground` without a command line", {"name": "Python"}, True),
        ("a shell where the loop was", shell, False),
        ("a login shell by its absolute path", {"argv": ["/bin/zsh", "-l"]}, False),
        ("another program", {"argv": ["vim", "notes.md"]}, False),
        ("another script of the workspace", {"argv": [interpreter, "/ws/herdr/bin/open-session", "/ws/gitops"]},
         False),
        ("the loop's script asked something else", {"argv": [interpreter, "/ws/herdr/bin/autopilot", "state",
                                                            "gitops"]}, False),
        ("the loop's script alone", {"argv": [interpreter, "/ws/herdr/bin/autopilot"]}, False),
        ("an autopilot script of another project", {"argv": [interpreter, "/ws/bin/autopilot", "run", "/ws/gitops"]},
         False),
    ]
    for what, foreground, want in in_front:
        plays(f"a pilot's state, live with {what}: {'on' if want else 'dead'}",
              {pilot_ls: ls(loop_row(status="working", turn=1)), loop_get: loop_terminal(foreground)},
              found, [pilot_ls, loop_get], "", ("t3", want))
    leaked = play(app, {pilot_ls: ls(loop_row(status="working", turn=1)), loop_get: loop_terminal(shell)}, found)
    cases.append(("the screen hc get answers for a loop is dropped and goes nowhere", SCREEN in repr(leaked), False))
    plays("a pilot whose terminal cannot be read is not taken for on or dead",
          {pilot_ls: ls(loop_row(status="working", turn=1)),
           loop_get: (3, '{"error":{"kind":"not_found","message":"t3 was removed"}}')},
          found, [pilot_ls, loop_get], "", "failed: hc get: not_found: t3 was removed")
    plays("hc get failing on a loop says its exit status, not its text",
          {pilot_ls: ls(loop_row(status="working", turn=1)), loop_get: (5, f'{{"screen":"{SCREEN}')},
          found, [pilot_ls, loop_get], "", "failed: hc get: exit status 5")
    plays("a pilot removed meanwhile is not an error", {
        pilot_ls: ls(loop_row(**gone, exit_code=0, reason="exited")), "hc rm t3": not_found},
          found, [pilot_ls, "hc rm t3"], "", None)
    plays("a loop's terminal ends with the loop: no tab of its own to close", {}, lambda: app.is_own_tab(tab), [],
          "", False)
    return cases


def stand_in_cases(tui):
    """(what, got, want) for the TUI backend's new arguments, with `herdr`
    replaced by a function that logs what it is asked, and for a round that
    only prints: nothing runs."""
    cases = []
    herdr_calls, ran = [], []

    def herdr(*args):
        herdr_calls.append(args)
        return {"workspaces": [], "tab": {"tab_id": "w1:1"}, "root_pane": {"pane_id": "p1"}}

    saved = tui.herdr, tui.run
    tui.herdr, tui.run = herdr, lambda *args: ran.append(args) or ""
    try:
        tui.start_pilot("gitops", "/ws/gitops", "/ws/herdr/bin/autopilot run /ws/gitops")
        cases.append(("tui: its loop is told its front end in the command typed into its pane",
                      ran, [(tui.HERDR, "pane", "run", "p1", "/ws/herdr/bin/autopilot run /ws/gitops --frontend tui")]))
        before = len(herdr_calls), len(ran)
        tui.start_session(None, "gitops-19", "/ws/gitops", "claude", {}, dry=True)
        tui.close_tab(tui.Tab("w1:1", "gitops"), dry=True)
        cases.append(("tui: a dry start and a dry close run nothing", (len(herdr_calls), len(ran)), before))
    finally:
        tui.herdr, tui.run = saved

    calls, out = [], io.StringIO()
    stand_in = types.SimpleNamespace(
        __name__="frontend.stand_in",
        find_space=lambda name: "space",
        workers=lambda space, dry: iter([frontend.Worker(5, "zz-selftest-5", "T5", "S5")]),
        session_state=lambda session: frontend.ENDED,
        close_tab=lambda tab, dry=False: calls.append(f"close_tab {tab} dry={dry}"),
        start_session=lambda space, name, directory, command, env, dry=False: calls.append(
            f"start_session {name} {env} dry={dry}"))
    saved_board, saved_backend = globals()["read_board"], frontend.backend
    globals()["read_board"] = lambda repo: Board([(987654, "2026-11-17T00:00:00Z")], set())
    frontend.backend = stand_in
    try:
        with contextlib.redirect_stdout(out):
            done = round_(Path("/nonexistent/zz-selftest"), "zz-selftest", "zz-selftest", {}, True)
    finally:
        globals()["read_board"], frontend.backend = saved_board, saved_backend
    log_lines = [line.split(" ", 1)[1] for line in out.getvalue().splitlines()]
    cases.append(("round: a dry round closes and starts through the layer, with dry set",
                  calls, ["close_tab T5 dry=True", "start_session zz-selftest-987654 {'OXC0_AUTOPILOT': '1'} dry=True"]))
    cases.append(("round: a dry round says what it would do",
                  [any(text in line for line in log_lines) for text in ("would close tab T5", "would start, in")],
                  [True, True]))
    cases.append(("round: a dry round is not the last one", done, False))
    return cases


def resting_cases():
    """(what, got, want) for which sessions a round closes, and what it reads
    of the board to tell (#274), over a stand-in backend and a stand-in board
    read: nothing runs."""
    cases = []
    repo, directory = "zz-selftest", Path("/nonexistent/zz-selftest")
    ready_at = "2026-11-17T00:00:00Z"
    last = "work-issue: done zz-selftest#5"
    working, idle = (frontend.BUSY, ""), (frontend.AT_REST, "Opened the PR.\n> ")

    def play_round(sessions, board, slot_count=1, dry=False):
        closed, started, reads, out = [], [], [], io.StringIO()

        def workers(space, dry):
            return iter([frontend.Worker(n, f"{repo}-{n}", f"T{n}", f"S{n}") for n in sessions])

        def read(repo):
            reads.append(repo)
            return board

        stand_in = types.SimpleNamespace(
            __name__="frontend.stand_in",
            find_space=lambda name: "space",
            workers=workers,
            session_state=lambda session: sessions[int(session[1:])][0],
            read_screen=lambda session: sessions[int(session[1:])][1],
            close_tab=lambda tab, dry=False: closed.append(tab),
            start_session=lambda space, name, directory, command, env, dry=False: started.append(name))
        saved = globals()["read_board"], globals()["slots"], frontend.backend
        globals()["read_board"], globals()["slots"], frontend.backend = read, lambda repo: slot_count, stand_in
        try:
            with contextlib.redirect_stdout(out):
                done = round_(directory, repo, repo, {}, dry)
        finally:
            globals()["read_board"], globals()["slots"], frontend.backend = saved
        return {"closed": closed, "reads": len(reads), "started": started, "done": done,
                "log": [line.split(" ", 1)[1] for line in out.getvalue().splitlines()]}

    def plays(what, sessions, board, want, **options):
        got = play_round(sessions, board, **options)
        cases.append((f"round: {what}", {key: got[key] for key in want}, want))

    plays("a session at rest whose issue is closed is closed, and the log says why",
          {5: idle}, Board([], {7}),
          {"closed": ["T5"], "reads": 1, "log": [f"{repo}#5: its issue is closed; tab closed"], "done": True})
    plays("a session at rest whose issue is open is left", {5: idle}, Board([], {5, 7}),
          {"closed": [], "reads": 1, "log": [], "done": False})
    plays("a session that is working is left, though its issue is closed, and the board is not read",
          {5: working}, Board([], {7}), {"closed": [], "reads": 0, "log": [], "done": False})
    plays("a session at rest with its last line is closed by it, not by the board",
          {5: (frontend.AT_REST, last)}, Board([], {5}),
          {"closed": ["T5"], "reads": 1, "log": [f"{repo}#5: done {repo}#5; tab closed"], "done": True})
    plays("a session at rest with its last line and its issue closed says its last line",
          {5: (frontend.AT_REST, last)}, Board([], {7}),
          {"closed": ["T5"], "log": [f"{repo}#5: done {repo}#5; tab closed"]})
    plays("a session that exited is closed", {5: (frontend.ENDED, "")}, Board([], {5}),
          {"closed": ["T5"], "log": [f"{repo}#5: its session exited; tab closed"]})
    plays("a board that could not be read (low budget) leaves a session at rest", {5: idle}, None,
          {"closed": [], "reads": 1, "log": [], "done": False})
    plays("a list of open issues cut at 100 cannot tell: the session is left, and it says so",
          {5: idle}, Board([], None),
          {"closed": [], "reads": 1, "done": False,
           "log": [f"{repo}: more than 100 open issues: a session at rest cannot be told from one "
                   "whose issue is closed"]})
    plays("two sessions at rest, one issue closed: one read, only that one is closed",
          {5: idle, 6: idle}, Board([], {6}),
          {"closed": ["T5"], "reads": 1, "done": False, "log": [f"{repo}#5: its issue is closed; tab closed"]},
          slot_count=2)
    plays("a session at rest and a free slot share one read, which also starts the Ready issue",
          {5: idle}, Board([(9, ready_at)], {5, 9}),
          {"closed": [], "reads": 1, "started": [f"{repo}-9"], "done": False}, slot_count=2, dry=True)
    plays("a dry round says the closed issue and closes nothing for real",
          {5: idle}, Board([], {7}),
          {"closed": ["T5"], "reads": 1, "log": [f"{repo}#5: its issue is closed; would close tab T5"]},
          dry=True)

    def read_with(answer):
        saved = globals()["run"]
        globals()["run"] = lambda *args, cwd=None: json.dumps(answer)
        try:
            with contextlib.redirect_stdout(io.StringIO()):
                return outcome(read_board, repo)
        finally:
            globals()["run"] = saved

    def item(status, priority, at=ready_at, project=BOARD):
        return {"project": {"number": project}, "updatedAt": at,
                "status": {"name": status} if status else None,
                "priority": {"name": priority} if priority else None}

    def issue(number, *items, blocked=0):
        return {"number": number, "issueDependenciesSummary": {"blockedBy": blocked},
                "projectItems": {"nodes": list(items)}}

    def answer(*issues, more=False, remaining=4000):
        return {"data": {"rateLimit": {"remaining": remaining, "resetAt": "2026-11-25T12:00:00Z"},
                         "repository": {"issues": {"pageInfo": {"hasNextPage": more}, "nodes": list(issues)}}}}

    issues = (issue(3, item("Ready", "P2")), issue(4, item("In Progress", "P1")),
              issue(8, item("Ready", "P1")), issue(9, item("Ready", "P1"), blocked=1),
              issue(11), issue(12, item("Ready", "P1", project=2)))
    cases.append(("board read: the Ready issues by priority, and every open issue",
                  read_with(answer(*issues)),
                  Board([(8, ready_at), (3, ready_at)], {3, 4, 8, 9, 11, 12})))
    cases.append(("board read: a list cut at 100 has no set of open issues, and the Ready ones it has",
                  read_with(answer(*issues, more=True)), Board([(8, ready_at), (3, ready_at)], None)))
    cases.append(("board read: no issue is open", read_with(answer()), Board([], set())))
    cases.append(("board read: a low budget reads nothing", read_with(answer(*issues, remaining=499)), None))
    return cases


def pilot_flow_cases():
    """(what, got, want) for how `start`, `toggle` and `state` look in each
    front end that answers, with a stand-in backend per front end that logs
    each operation as `<front end>.<operation>`: nothing runs."""
    cases = []
    d = Path("/ws/gitops")

    def flow(what, action, found, picked="tui", core=()):
        calls, out = [], io.StringIO()

        def load(name):
            def pilot(space):
                calls.append(f"{name}.pilot")
                return f"{name}:{found[name]}" if name in found else None

            def pilot_alive(tab):
                calls.append(f"{name}.pilot_alive")
                return tab.endswith(":live")

            def close_tab(tab, dry=False):
                calls.append(f"{name}.close_tab")

            def start_pilot(space, directory, command):
                calls.append(f"{name}.start_pilot {space}")
            return types.SimpleNamespace(__name__=f"frontend.{name}", pilot=pilot, pilot_alive=pilot_alive,
                                         close_tab=close_tab, start_pilot=start_pilot)

        saved = frontend.load, frontend.backend
        frontend.load = load
        try:
            with contextlib.redirect_stdout(out):
                result = outcome(lambda: action(d, picked, asks(core=core)))
        finally:
            frontend.load, frontend.backend = saved
        return calls, out.getvalue(), result

    def flows(what, found, picked, core, state_want, start_want, toggle_want):
        for action, (calls, printed, result) in (("state", state_want), ("start", start_want),
                                                 ("toggle", toggle_want)):
            got = flow(what, globals()[action], found, picked, core)
            cases.append((f"{action}, {what}", got, (calls, printed, result)))

    on, off = "gitops: autopilot on\n", "gitops: autopilot off\n"
    flows("only the TUI answers, the pilot is on there", {"tui": "live"}, "tui", (),
          (["tui.pilot", "tui.pilot_alive"], "", "on"),
          (["tui.pilot", "tui.pilot_alive"], "gitops: autopilot already on\n", None),
          (["tui.pilot", "tui.close_tab"], off, None))
    flows("only the TUI answers, the pilot is dead there", {"tui": "dead"}, "tui", (),
          (["tui.pilot", "tui.pilot_alive"], "", "dead"),
          (["tui.pilot", "tui.pilot_alive", "tui.close_tab", "tui.start_pilot gitops"],
           "gitops: autopilot was dead; restarting\n" + on, None),
          (["tui.pilot", "tui.close_tab"], off, None))
    flows("only the TUI answers, no pilot", {}, "tui", (),
          (["tui.pilot"], "", "off"),
          (["tui.pilot", "tui.start_pilot gitops"], on, None),
          (["tui.pilot", "tui.start_pilot gitops"], on, None))
    flows("the app does not answer, so it is not asked, though it has one", {"app": "live"}, "tui", (),
          (["tui.pilot"], "", "off"),
          (["tui.pilot", "tui.start_pilot gitops"], on, None),
          (["tui.pilot", "tui.start_pilot gitops"], on, None))
    flows("the pilot is on in the app, the TUI picked", {"app": "live"}, "tui", ("app",),
          (["tui.pilot", "app.pilot", "app.pilot_alive"], "", "on"),
          (["tui.pilot", "app.pilot", "app.pilot_alive"], "gitops: autopilot already on (in the app)\n", None),
          (["tui.pilot", "app.pilot", "app.close_tab"], "gitops: autopilot off (in the app)\n", None))
    flows("the pilot is on in the TUI, the app picked", {"tui": "live"}, "app", ("tui",),
          (["app.pilot", "tui.pilot", "tui.pilot_alive"], "", "on"),
          (["app.pilot", "tui.pilot", "tui.pilot_alive"], "gitops: autopilot already on (in the TUI)\n", None),
          (["app.pilot", "tui.pilot", "tui.close_tab"], "gitops: autopilot off (in the TUI)\n", None))
    flows("the pilot is on in the app, the app picked", {"app": "live"}, "app", ("tui",),
          (["app.pilot", "tui.pilot", "app.pilot_alive"], "", "on"),
          (["app.pilot", "tui.pilot", "app.pilot_alive"], "gitops: autopilot already on\n", None),
          (["app.pilot", "tui.pilot", "app.close_tab"], off, None))
    flows("the pilot is dead in the TUI, the app picked", {"tui": "dead"}, "app", ("tui",),
          (["app.pilot", "tui.pilot", "tui.pilot_alive"], "", "dead"),
          (["app.pilot", "tui.pilot", "tui.pilot_alive", "tui.close_tab", "app.start_pilot gitops"],
           "gitops: autopilot was dead (in the TUI); restarting\n" + on, None),
          (["app.pilot", "tui.pilot", "tui.close_tab"], "gitops: autopilot off (in the TUI)\n", None))
    flows("on in the app, dead in the TUI, the TUI picked: on wins", {"app": "live", "tui": "dead"}, "tui", ("app",),
          (["tui.pilot", "app.pilot", "tui.pilot_alive", "app.pilot_alive"], "", "on"),
          (["tui.pilot", "app.pilot", "tui.pilot_alive", "app.pilot_alive"],
           "gitops: autopilot already on (in the app)\n", None),
          (["tui.pilot", "app.pilot", "tui.close_tab", "app.close_tab"],
           "gitops: autopilot off\ngitops: autopilot off (in the app)\n", None))
    flows("no pilot in either", {}, "app", ("tui",),
          (["app.pilot", "tui.pilot"], "", "off"),
          (["app.pilot", "tui.pilot", "app.start_pilot gitops"], on, None),
          (["app.pilot", "tui.pilot", "app.start_pilot gitops"], on, None))

    def parsed(command, rest):
        try:
            return options(command, rest)
        except SystemExit as e:
            return f"usage: {str(e.code).splitlines()[0]}"

    first = USAGE.splitlines()[0]
    for what, command, rest, want in [
        ("a dry run in the app", "run", ["--dry-run", "--frontend", "app"], (True, "app")),
        ("the option with an equals sign", "start", ["--frontend=tui"], (False, "tui")),
        ("no options", "toggle", [], (False, None)),
        ("state takes the front end", "state", ["--frontend", "app"], (False, "app")),
        ("only run takes --dry-run", "start", ["--dry-run"], f"usage: {first}"),
        ("an option that is not one", "run", ["--dryrun"], f"usage: {first}"),
        ("the option without a value", "run", ["--frontend"], f"usage: {first}"),
        ("an empty value", "run", ["--frontend="], f"usage: {first}"),
    ]:
        cases.append((f"options: {what}", parsed(command, rest), want))
    return cases


def frontend_cases():
    """(what, got, want) for the layer's rule and for the app backend, from
    fake environments and answers of `hc` and `herdr-app`; nothing runs.
    Recorded from the real programs on 2026-11-17 (0xc0-labs/workspace#226):
    the `hc ls` answers with a session and with none, `hc run`'s, and
    `herdr-app do`'s `{"ok": true}`. Stand-ins of the documented shape: two
    sessions listed, the list of the window's commands, `herdr-app do`'s
    `{"error": …}` with exit status 1, and the errors of `hc`, whose kinds
    `unavailable` and `name_taken` are named in `hc schema`, with their exit
    statuses and messages. What the autopilot's cases record and stand in for
    is in `app_autopilot_cases`."""
    cases = []
    app, tui = frontend.load("app"), frontend.load("tui")
    for name in frontend.FRONTENDS:
        lacks = frontend.lacking(frontend.load(name))
        has = [op for op in frontend.OPERATIONS if op not in lacks]
        print(f"{name}: has " + ("every operation" if not lacks else ", ".join(has)) +
              (f"; lacks {', '.join(lacks)}" if lacks else ""))
    cases.append(("the tui backend lacks no operation", frontend.lacking(tui), []))
    cases.append(("the app backend lacks no operation", frontend.lacking(app), []))
    saved = frontend.backend
    frontend.backend = types.ModuleType("frontend.stand_in")
    try:
        cases.append(("an operation a backend lacks fails with a message",
                      outcome(frontend.find_space, "gitops"),
                      "failed: the stand_in front end does not offer find_space yet"))
    finally:
        frontend.backend = saved

    var = frontend.FRONTEND_ENV
    not_installed = "failed: the {} front end is not installed ({}): {}-program not found in PATH"
    rules = [
        ("the option wins over the variable", ("app", {var: "tui"}, asks()), "app"),
        ("the variable wins over where this runs", (None, {var: "tui", "HC_TERMINAL_ID": "t2"}, asks()), "tui"),
        ("the variable alone", (None, {var: "app"}, asks()), "app"),
        ("an empty variable is not set", (None, {var: "", "HERDR_ENV": "1"}, asks()), "tui"),
        ("a terminal of the app", (None, {"HC_TERMINAL_ID": "t2"}, asks()), "app"),
        ("a pane of the TUI", (None, {"HERDR_ENV": "1", "HERDR_PANE_ID": "p1"}, asks(window=True)), "tui"),
        ("a popup of the TUI, which has no pane id, with the app's window open",
         (None, {"HERDR_ENV": "1"}, asks(window=True)), "tui"),
        ("both: the TUI", (None, {"HERDR_ENV": "1", "HC_TERMINAL_ID": "t2"}, asks(window=True)), "tui"),
        ("both, with a pane id: the TUI",
         (None, {"HERDR_ENV": "1", "HERDR_PANE_ID": "p1", "HC_TERMINAL_ID": "t2"}, asks(window=True)), "tui"),
        ("a pane id alone does not tell the TUI", (None, {"HERDR_PANE_ID": "p1"}, asks(window=True)), "app"),
        ("HERDR_ENV other than 1 does not tell the TUI", (None, {"HERDR_ENV": "0"}, asks(window=True)), "app"),
        ("outside both, the window answers", (None, {}, asks(window=True)), "app"),
        ("outside both, the window does not answer", (None, {}, asks(window=False)), "tui"),
        ("outside both, the app is not installed", (None, {}, asks(installed=("tui",))), "tui"),
        ("an unknown option", ("gui", {}, asks()), "failed: --frontend: 'gui' is not a front end: use tui or app"),
        ("an unknown variable", (None, {var: "gui"}, asks()),
         f"failed: ${var}: 'gui' is not a front end: use tui or app"),
        ("the app asked for, not installed", ("app", {}, asks(installed=("tui",))),
         not_installed.format("app", "--frontend", "app")),
        ("a terminal of the app, not installed", (None, {"HC_TERMINAL_ID": "t2"}, asks(installed=("tui",))),
         not_installed.format("app", "this runs in one of its terminals", "app")),
        ("no window, the TUI not installed", (None, {}, asks(installed=("app",))),
         not_installed.format("tui", "the app's window does not answer", "tui")),
    ]
    for what, args, want in rules:
        cases.append((f"rule: {what}", outcome(frontend.choose, *args), want))
    looking = [
        ("the other front end answers", ("tui", asks(core=("app",))), ["tui", "app"]),
        ("the app is not installed", ("tui", asks(installed=("tui",), core=("app",))), ["tui"]),
        ("the core does not answer", ("tui", asks()), ["tui"]),
        ("the app is first when picked", ("app", asks(core=("tui",))), ["app", "tui"]),
        ("the picked one is listed as it is", ("app", asks()), ["app"]),
    ]
    for what, args, want in looking:
        cases.append((f"looking in: {what}", frontend.answering(*args), want))

    listed = ('{"hidden_finished":0,"terminals":[{"address":"t9","agent":"claude-code","cwd":"/ws/gitops",'
              '"name":"gitops","state":"live","status":"working","turn":3}]}')
    two = '{"hidden_finished":0,"terminals":[{"address":"t9","agent":"claude-code"},{"address":"t12","agent":"claude"}]}'
    none = '{"hidden_finished":0,"terminals":[]}'
    started = '{"address":"t9","agent":"claude","cwd":"/ws/gitops","name":"gitops","state":"live","turn":0}'
    pair = [{"name": "id", "required": True}, {"name": "name", "required": True}]
    commands = json.dumps([
        {"name": "space.rename", "args": pair, "about": ""},
        {"name": "tab.rename", "args": pair, "about": ""},
        {"name": "agent.focus", "args": [{"name": "terminal", "required": True}], "about": ""},
    ])
    no_focus = json.dumps([c for c in json.loads(commands) if c["name"] != "agent.focus"])
    ok, not_shown = (0, '{"ok": true}'), (1, '{"error": "no such space"}')
    lookup = "hc ls --label oxc0.space=gitops --label oxc0.role=session --json"
    status, listing = "herdr-app status", "herdr-app commands"
    start = ("hc run --bg --keep --rm --no-parent --no-notify --json --name gitops --cwd /ws/gitops "
             "--label herdr.space=oxc0-gitops --label herdr.tab=oxc0-gitops "
             "--label oxc0.space=gitops --label oxc0.role=session -- claude -n gitops /0xc0:work-issue")
    space = "herdr-app do space.rename --id oxc0-gitops --name gitops"
    tab = "herdr-app do tab.rename --id oxc0-gitops --name gitops"
    focus = "herdr-app do agent.focus --terminal t9"
    by_hand = ["-n", "gitops", "/0xc0:work-issue"]
    window = {status: (0, "{}"), listing: (0, commands)}
    no_window = "# the app's window does not answer: nothing to name or focus\n"
    session = app.Session("t9", "gitops")

    def plays(what, recorded, action, ran, printed, result):
        cases.append((f"app: {what}", play(app, recorded, action), (ran, printed, result)))

    def find():
        return app.find_session("gitops")

    def open_(*more):
        return lambda: app.open_session("gitops", "/ws/gitops", by_hand, *more)

    plays("a session found", {lookup: (0, listed)}, find, [lookup], "", session)
    plays("no session found", {lookup: (0, none)}, find, [lookup], "", None)
    plays("two sessions found: the first, and it says so", {lookup: (0, two)}, find, [lookup],
          "gitops: 2 sessions carry its labels (t9, t12); taking the first, t9\n", session)
    plays("no core to look in", {lookup: (5, '{"error":{"kind":"unavailable","message":"no core running"}}')},
          find, [lookup], "", "failed: hc ls: unavailable: no core running")
    plays("the window answers", window, app.shows, [status], "", True)
    plays("the window does not answer", {status: (2, "")}, app.shows, [status], "", False)
    plays("a session opened with the window: named, retried until shown, focused",
          {**window, start: (0, started), space: [not_shown, not_shown, ok], tab: ok, focus: ok},
          open_(), [status, listing, start, space, space, space, tab, focus], "", None)
    plays("a session opened without the window still starts, and says so",
          {status: (2, ""), start: (0, started)}, open_(), [status, start],
          "gitops started as t9, and the app's window was not there to name or show it\n", None)
    plays("a dry run with the window prints the commands and runs none of them", window, open_(True),
          [status, listing],
          "\n".join([start, space, tab, "herdr-app do agent.focus --terminal '<new terminal>'"]) + "\n", None)
    plays("a dry run without the window prints the session's command", {status: (2, "")}, open_(True),
          [status], start + "\n" + no_window, None)
    plays("the orchestrator's has no prompt", {status: (2, "")},
          lambda: app.open_session("orchestrator", "/ws", ["-n", "orchestrator"], True), [status],
          start.replace("gitops", "orchestrator").replace("/ws/orchestrator", "/ws")
          .replace(" /0xc0:work-issue", "") + "\n" + no_window, None)
    plays("a window that never shows the terminal", {**window, start: (0, started), space: not_shown}, open_(),
          [status, listing, start] + [space] * app.ATTEMPTS, "",
          "failed: gitops started as t9, but the window did not show it: no such space")
    plays("a window without a command used here fails before anything starts",
          {status: (0, "{}"), listing: (0, no_focus)}, open_(), [status, listing], "",
          "failed: herdr-app has no command agent.focus with terminal (`herdr-app commands` lists them): "
          "was it changed?")
    plays("a name taken tells how to adopt the session",
          {status: (2, ""), start: (4, '{"error":{"kind":"name_taken","message":"gitops is taken"}}')},
          open_(), [status, start], "",
          "failed: hc run: name_taken: gitops is taken: a terminal has this name without the labels "
          "of a session; if it is the session, adopt it with "
          "`hc label <terminal> oxc0.space=gitops oxc0.role=session`")
    plays("a session found is focused through the window", {**window, focus: ok},
          lambda: app.focus_session(session), [status, listing, focus], "", None)
    plays("a session found, no window: it says so and focuses nothing", {status: (2, "")},
          lambda: app.focus_session(session), [status],
          "gitops runs as t9, and the app's window is not there to show it\n", None)

    cases.extend(core_cases(app))
    cases.extend(app_autopilot_cases(app))

    forbidden = re.compile(r"^hc (send|keys|attach|get|read|label|kill|rm|wait)\b|--force")
    ran = [line for what, got, _ in cases if what.startswith("app: ") for line in got[0]]
    cases.append(("opening a session by hand never types into a terminal, reads one, ends one or forces",
                  [line for line in ran if forbidden.search(line)], []))
    never = re.compile(r"^hc (send|keys|attach|label|server)\b|--force")
    ran = [line for what, got, _ in cases if what.startswith(("app: ", "app autopilot: ")) for line in got[0]]
    cases.append(("the app backend never sends, presses keys, attaches, labels, touches the server or forces",
                  [line for line in ran if never.search(line)], []))
    cases.append(("the app backend runs hc get only for the one terminal, as JSON",
                  [line for line in ran if line.startswith("hc get") and not re.fullmatch(r"hc get t\d+ --json", line)],
                  []))
    cases.extend(stand_in_cases(tui))
    cases.extend(resting_cases())
    cases.extend(pilot_flow_cases())
    return cases


def self_test():
    mention = "The `work-issue: done gitops#82` line also waits until then."
    cases = [
        ("gitops", 82, "work-issue: done gitops#82", "done gitops#82"),
        ("gitops", 82, "  work-issue: done gitops#82  ", "done gitops#82"),
        ("gitops", 82, "work-issue: stopped gitops#82: checks red", "stopped gitops#82: checks red"),
        ("gitops", 82, "\u23fa work-issue: done gitops#82", "done gitops#82"),
        ("gitops", 82, "\u23fa work-issue: stopped gitops#82: no access", "stopped gitops#82: no access"),
        ("gitops", 82, mention, None),
        ("gitops", 82, "work-issue: done gitops#82 and more", None),
        ("gitops", 82, "work-issue: stopped gitops#82:", None),
        ("gitops", 8, "work-issue: done gitops#82", None),
        ("gitops", 82, "work-issue: done gitops#8", None),
        ("gitops", 82, "work-issue: done other#82", None),
        ("gitops", 82, f"work-issue: done gitops#82\n{mention}\n> prompt", "done gitops#82"),
    ]
    failed = [c for c in cases if find_last_line(c[0], c[1], c[2]) != c[3]]
    for repo, n, screen, want in failed:
        print(f"FAIL {repo}#{n} {screen!r}: want {want!r}, got {find_last_line(repo, n, screen)!r}")
    enabled = {"enabledPlugins": {
        "0xc0@0xc0-labs": True,
        "agent-skills@0xc0-labs": True,
        "software-architecture@0xc0-labs": False,
        "typescript-lsp@claude-plugins-official": True,
        "terraform@hashicorp": True,
        "0xc0@0xc0-labs-fork": True,
    }}
    plugin_cases = [
        (enabled, ["0xc0@0xc0-labs", "agent-skills@0xc0-labs"]),
        ({"enabledPlugins": {"0xc0@hashicorp": True, "0xc0@0xc0-labs": False}}, []),
        ({"enabledPlugins": {}}, []),
        ({}, []),
    ]
    failed_plugins = [c for c in plugin_cases if org_plugins(c[0]) != c[1]]
    for settings, want in failed_plugins:
        print(f"FAIL org_plugins {settings!r}: want {want!r}, got {org_plugins(settings)!r}")
    frontend_results = frontend_cases()
    failed_frontend = [c for c in frontend_results if c[1] != c[2]]
    for what, got, want in failed_frontend:
        print(f"FAIL {what}:\n  want {want!r}\n  got  {got!r}")
    total = len(cases) + len(plugin_cases) + len(frontend_results)
    failures = len(failed) + len(failed_plugins) + len(failed_frontend)
    print(f"{total - failures}/{total} passed")
    return not failures


def clean_up(d, session, dry):
    """Removes the session's worktree once nothing in it exists only here."""
    wt = WORKTREES / session
    if not wt.is_dir():
        return
    if git(wt, "status", "--porcelain").stdout.strip():
        log(f"{session}: worktree kept, it has uncommitted changes: {wt}")
        return
    git(wt, "fetch", "--prune", "--quiet", "origin")
    # A session that ended with nothing of its own, on a branch it never pushed.
    if git(wt, "merge-base", "--is-ancestor", "HEAD", "origin/main").returncode == 0:
        remove_worktree(d, session, wt, dry, "")
        return
    branch = git(wt, "symbolic-ref", "--quiet", "--short", "HEAD").stdout.strip()
    gone = bool(branch) and git(wt, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{branch}").returncode != 0
    if gone:
        # A squash merge puts the branch's commits in main under other SHAs (#134).
        try:
            pr = json.loads(run("mise", "exec", "--", "gh", "pr", "view", branch, "--repo", f"{ORG}/{d.name}",
                                "--json", "state,headRefOid", cwd=ROOT))
        except (Failed, json.JSONDecodeError) as e:
            log(f"{session}: worktree kept, {branch} is gone from origin and its PR could not be read ({e}): {wt}")
            return
        if pr["state"] != "MERGED":
            log(f"{session}: worktree kept, {branch} is gone from origin and its PR is {pr['state']}: {wt}")
            return
        if git(wt, "merge-base", "--is-ancestor", "HEAD", pr["headRefOid"]).returncode:
            log(f"{session}: worktree kept, {branch} has commits not in its merged PR: {wt}")
            return
    elif git(wt, "merge-base", "--is-ancestor", "HEAD", f"origin/{branch or 'main'}").returncode:
        log(f"{session}: worktree kept, {branch or 'HEAD'} has commits not on origin: {wt}")
        return
    remove_worktree(d, session, wt, dry, ", its PR merged" if gone else "")


def remove_worktree(d, session, wt, dry, merged):
    if dry:
        log(f"{session}: would remove its worktree {wt}{merged}")
        return
    branch = git(wt, "symbolic-ref", "--quiet", "--short", "HEAD").stdout.strip()
    p = git(d, "worktree", "remove", str(wt))
    if p.returncode:
        log(f"{session}: worktree kept, {p.stderr.strip()}")
        return
    if branch:
        git(d, "branch", "--delete", "--force", branch)
    log(f"{session}: worktree removed{merged}")


def verdict(repo, worker):
    """(why the worker's session is over, or None; whether it is at rest)."""
    state = frontend.session_state(worker.session)
    if state == frontend.ENDED:
        return "its session exited", False
    if state == frontend.AT_REST:
        return last_line(repo, worker.n, worker.session), True
    return None, False


def finish(d, repo, worker, reason, dry):
    """Closes the tab of a worker whose session is over, and its worktree."""
    n = worker.n
    if dry:
        log(f"{repo}#{n}: {reason}; would close tab {worker.tab}")
        frontend.close_tab(worker.tab, dry=True)
    else:
        frontend.close_tab(worker.tab)
        log(f"{repo}#{n}: {reason}; tab closed")
    clean_up(d, worker.name, dry)


def worktree_settings():
    """Claude Code runs a plugin's WorktreeCreate too late for `-w`, so the
    hooks that place the worktree in .worktrees/ come in through --settings."""
    def hook(script):
        return [{"hooks": [{"type": "command", "command": shlex.quote(str(HOOKS / script))}]}]

    if not (HOOKS / "worktree-create.sh").is_file():
        raise Failed(f"no worktree hooks in {HOOKS}: is claude-config on main?")
    WORKTREES.mkdir(exist_ok=True)
    (WORKTREES / ".hooks.json").write_text(json.dumps({"hooks": {
        "WorktreeCreate": hook("worktree-create.sh"),
        "WorktreeRemove": hook("worktree-remove.sh"),
    }}, indent=2) + "\n")


def claim(repo, n, dry):
    """Moves the issue to In Progress on the board, so the claim does not
    depend on the session's own step (#161). False when it could not."""
    command = ["mise", "exec", "--", "gh", "project", "item-edit", str(BOARD), "--owner", ORG,
               "--url", f"https://github.com/{ORG}/{repo}/issues/{n}",
               "--field", "Status", "--value", "In Progress"]
    if dry:
        log(f"{repo}#{n}: would move to In Progress: {shlex.join(command[3:])}")
        return True
    try:
        run(*command, cwd=ROOT)
    except Failed as e:
        log(f"{repo}#{n}: not started, could not move it to In Progress, retrying next round: {e}")
        return False
    log(f"{repo}#{n}: moved to In Progress")
    return True


def launch(d, repo, space, session, n, dry):
    """Starts the issue's session; False only when a failed claim should be
    retried next round."""
    if not claim(repo, n, dry):
        return False
    args = ["--permission-mode", "auto", "--settings", str(WORKTREES / ".hooks.json"),
            "-n", session, "-w", session, f"/0xc0:work-issue {repo}#{n}"]
    command = shlex.join(["claude", *args])
    # The 0xc0 plugin's SessionStart hook skips the board read on it (#130).
    env = {"OXC0_AUTOPILOT": "1"}
    if dry:
        log(f"{repo}#{n}: would start, in {d}: {command}")
        frontend.start_session(space, session, d, command, env, dry=True)
        return True
    worktree_settings()
    frontend.start_session(space, session, d, command, env)
    log(f"{repo}#{n}: started {session}")
    return True


KEPT_LOGGED = {}


def say_kept(repo, n, wt):
    """The kept-worktree line for an issue held back, when it first appears and
    then at most once per KEPT_REPEAT."""
    if time.monotonic() - KEPT_LOGGED.get(n, -KEPT_REPEAT) < KEPT_REPEAT:
        return
    KEPT_LOGGED[n] = time.monotonic()
    log(f"{repo}#{n}: not started, its worktree was kept: {wt}; "
        "removing it lets the issue start on the next round")


def now_utc():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def round_(d, repo, name, launched, dry):
    """One round; True when nothing is left: no session tab, and nothing Ready
    on the board. `launched` maps each issue started to when its session ended
    (None while it runs). An issue still Ready counts as Ready, but is started
    again only when its board item changed after that end (#164): it went back
    to Ready, not the same block again. The comparison uses the `updatedAt` the
    round's board read already returns, so it costs no API call.

    A session at rest that printed no last line is over once its issue is no
    longer among the repo's open issues (#274). The round reads the board once,
    the first time it needs to: for such a session, or for a free slot. While
    every slot is held, that read is the only request the round makes, and
    only when a session is at rest without its last line."""
    space = frontend.find_space(name)
    if space is None and not dry:
        raise Failed(f"no Herdr workspace named {name}")
    reads = []

    def board():
        if not reads:
            reads.append(read_board(repo))
        return reads[0]

    def ended(worker, reason):
        finish(d, repo, worker, reason, dry)
        launched[worker.n] = now_utc()

    busy, resting = set(), []
    for worker in frontend.workers(space, dry):
        reason, at_rest = verdict(repo, worker)
        if reason:
            ended(worker, reason)
        elif at_rest:
            resting.append(worker)
        else:
            busy.add(worker.n)
    if resting:
        current = board()
        still_open = current.still_open if current else None
        if current and still_open is None:
            log(f"{repo}: more than 100 open issues: a session at rest cannot be told from one "
                "whose issue is closed")
        for worker in resting:
            if still_open is not None and worker.n not in still_open:
                ended(worker, "its issue is closed")
            else:
                busy.add(worker.n)
    for n in launched:
        if n not in busy and launched[n] is None:
            launched[n] = now_utc()
    free = slots(repo) - len(busy)
    if free <= 0:
        return False
    current = board()
    if current is None:
        return False
    found = current.ready
    todo, left = [], []
    for n, changed in found:
        if n in busy:
            continue
        if n not in launched or changed > launched[n]:
            todo.append(n)
        else:
            left.append(n)
    held = [n for n in todo if (WORKTREES / f"{name}-{n}").exists()]
    for n in held:
        say_kept(repo, n, WORKTREES / f"{name}-{n}")
    todo = [n for n in todo if n not in held][:free]
    if left and not todo:
        log(f"{repo}: waiting, started before and unchanged since its session ended: "
            + ", ".join(f"#{n}" for n in left))
    if todo and dry:
        settings = d / ".claude" / "settings.json"
        would = org_plugins(json.loads(settings.read_text())) if settings.is_file() else []
        log(f"{repo}: would update {', '.join(would) or 'no plugin'}")
    elif todo:
        update_plugin(d)
    for n in todo:
        if launch(d, repo, space, f"{name}-{n}", n, dry):
            launched[n] = None
    return not busy and not found


def prepare(d):
    """Gets the clone ready for its sessions. It stays at its path, which
    holds every worktree session's plugin records, trust, memory and
    approvals."""
    if d != ROOT:
        if not (d / ".git").is_dir():
            log(f"{d.name}: cloning {ORG}/{d.name}")
            run("mise", "exec", "--", "gh", "repo", "clone", f"{ORG}/{d.name}", str(d), cwd=ROOT)
        to_main(d)
    plugins(d)
    trust(d)  # after `claude plugin list`, which creates a new machine's ~/.claude.json


def trust(d):
    """Accepts Claude Code's trust dialog for the clone, which a new repo's
    first session stopped at: the org's repos are trusted (#136). Its
    worktree sessions run on the clone's entry."""
    origin = git(d, "remote", "get-url", "origin").stdout.strip()
    if not re.search(rf"[:/]{ORG}/[^/]+$", origin):
        log(f"{d.name}: not trusted, its origin is not in {ORG}: {origin or 'none'}")
        return
    if not CLAUDE_JSON.is_file():
        log(f"{d.name}: not trusted, there is no {CLAUDE_JSON} yet")
        return
    lock = Path(f"{CLAUDE_JSON}.lock")
    if not take_config_lock(lock):
        log(f"{d.name}: not trusted, {lock} stayed held")
        return
    try:
        config = json.loads(CLAUDE_JSON.read_text(encoding="utf-8"))
        project = config.setdefault("projects", {}).setdefault(str(d), dict(NEW_PROJECT))
        if project.get("hasTrustDialogAccepted") is True:
            return
        project["hasTrustDialogAccepted"] = True
        # Claude Code's JSON.stringify(config, null, 2): the rest stays byte for byte.
        replace_config(json.dumps(config, indent=2, ensure_ascii=False))
    finally:
        lock.rmdir()
    log(f"{d.name}: trusted in {CLAUDE_JSON}")


def take_config_lock(lock):
    """True once taken. Claude Code writes its config under proper-lockfile's
    lock, a directory its holder keeps fresh and another takes over once it
    is stale: a write that skipped it could lose a session's, or a session
    ours."""
    for _ in range(100):
        try:
            lock.mkdir()
            return True
        except FileExistsError:
            pass
        try:
            if time.time() - lock.stat().st_mtime > CONFIG_LOCK_STALE:
                lock.rmdir()
                continue
        except FileNotFoundError:
            continue
        time.sleep(0.1)
    return False


def replace_config(text):
    """A temporary file beside it, then a rename: a session never reads it
    half written."""
    target = CLAUDE_JSON.resolve()
    fd, tmp = tempfile.mkstemp(dir=target.parent, prefix=f".{target.name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, stat.S_IMODE(target.stat().st_mode))
        os.replace(tmp, target)
    except BaseException:
        os.unlink(tmp)
        raise


def to_main(d):
    """Puts the clone on an up-to-date main, unless a branch origin still has,
    or uncommitted work, says someone works in it."""
    git(d, "fetch", "--prune", "--quiet", "origin")
    branch = git(d, "branch", "--show-current").stdout.strip()
    if branch != "main":
        track = git(d, "for-each-ref", "--format=%(upstream:track)", f"refs/heads/{branch}").stdout.strip()
        if not branch or track != "[gone]":
            log(f"{d.name}: clone left on {branch or 'a detached HEAD'}")
            return
        if git(d, "status", "--porcelain").stdout.strip():
            log(f"{d.name}: clone left on {branch}, it has uncommitted changes")
            return
        p = git(d, "switch", "--quiet", "main")
        if p.returncode:
            log(f"{d.name}: clone left on {branch}: {p.stderr.strip()}")
            return
    p = git(d, "pull", "--ff-only", "--quiet")
    if p.returncode:
        log(f"{d.name}: main not updated: {p.stderr.strip()}")


def claude_plugin(d, *args):
    p = subprocess.run(["claude", "plugin", *args], cwd=d, capture_output=True, text=True)
    if p.returncode:
        log(f"{d.name}: claude plugin {' '.join(args)}: {(p.stderr or p.stdout).strip()}")
    return p.returncode == 0


def plugins(d):
    """Installs the plugins the repo enables that have no record for its path
    (#106), then updates the org's."""
    settings = d / ".claude" / "settings.json"
    installed = json.loads(run("claude", "plugin", "list", "--json", cwd=d))
    for plugin, on in json.loads(settings.read_text()).get("enabledPlugins", {}).items():
        if on and not any(i["id"] == plugin and (i.get("scope") == "user" or i.get("projectPath") == str(d))
                          for i in installed):
            log(f"{d.name}: installing {plugin}")
            claude_plugin(d, "install", plugin, "--scope", "local")
    update_plugin(d)


def org_plugins(settings):
    """The org's marketplace's plugins that a settings file enables."""
    return [plugin for plugin, on in settings.get("enabledPlugins", {}).items()
            if on is True and plugin.endswith(f"@{MARKETPLACE}")]


def update_plugin(d):
    """Updates every plugin of the org's marketplace the repo enables, which
    Claude Code would update only after a session had started on the old one
    (#114): a session loads the install on disk when it starts (#124), and
    an autopilot's session lives for one issue (#221)."""
    settings = d / ".claude" / "settings.json"
    CACHE.mkdir(parents=True, exist_ok=True)
    # Several autopilots share one marketplace clone, ~/.claude/plugins/marketplaces/0xc0-labs, and concurrent updates break it (#132).
    with open(CACHE / "plugin-update.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        before = settings.read_text()
        if not marketplace_fresh() and claude_plugin(d, "marketplace", "update", MARKETPLACE):
            MARKETPLACE_STAMP.touch()
        for plugin in org_plugins(json.loads(before)):
            claude_plugin(d, "update", plugin)
        after = settings.read_text()
        if after != before and json.loads(after) == json.loads(before):
            settings.write_text(before)  # a project-scope update rewrites it with its keys reordered


def marketplace_fresh():
    try:
        return time.time() - MARKETPLACE_STAMP.stat().st_mtime < MARKETPLACE_FRESH
    except FileNotFoundError:
        return False


def code():
    """The script and the layer's files, listed afresh each time: a file added
    to lib/frontend/ is code from then on. The package's `__init__.py` is
    listed even when it is gone, so that code without it is not run."""
    return [SCRIPT, *sorted({FRONTEND / "__init__.py", *FRONTEND.glob("*.py")})]


def watched():
    """What the loop reads from herdr/: a change to any of it, a file added or
    removed included, is picked up between rounds."""
    return [*code(), CONF]


def fingerprint():
    """The size and mtime of each watched file, by path; a missing one reads as
    None."""
    def stamp(path):
        try:
            st = path.stat()
            return st.st_mtime_ns, st.st_size
        except OSError:
            return None
    return {p: stamp(p) for p in watched()}


def restart_if_changed(seen, launched):
    """Re-executes the loop when its own code changed, between rounds, with
    the same arguments and the issues it started carried in the environment.
    Code that does not compile, the script or a file of the layer, is not run:
    the loop keeps going on the old code and looks again only when a watched
    file changes once more. Returns the fingerprint to compare with next."""
    now = fingerprint()
    if now == seen:
        return seen
    try:
        for path in code():
            compile(path.read_text(), str(path), "exec")
    except (OSError, SyntaxError, ValueError) as e:
        log(f"autopilot code changed but cannot be loaded, keeping the running one: {e}")
        return now
    log("autopilot code changed; restarting")
    os.environ[LAUNCHED_ENV] = ",".join(f"{n}={at or ''}" for n, at in sorted(launched.items()))
    os.execv(sys.executable, [sys.executable, str(SCRIPT), *sys.argv[1:]])


def loop(d, dry):
    repo, name = d.name, session_name(d.name)
    restarted = LAUNCHED_ENV in os.environ
    carried = os.environ.pop(LAUNCHED_ENV, "")
    log(f"{repo}: " + ("dry run" if dry else "autopilot restarted" if restarted else "autopilot on")
        + f", {slots(repo)} at a time")
    if not dry and not restarted:
        prepare(d)
    launched = {}
    for entry in filter(None, carried.split(",")):
        n, _, at = entry.partition("=")
        launched[int(n)] = at or None
    seen = fingerprint()
    while True:
        done = False
        try:
            done = round_(d, repo, name, launched, dry)
        except (Failed, OSError, json.JSONDecodeError, KeyError) as e:
            log(f"error: {e}")
        if dry:
            return
        if done:
            log(f"{repo}: nothing Ready on the board and no session running; autopilot off")
            tab = frontend.pilot(name)
            if tab and frontend.is_own_tab(tab):
                frontend.close_tab(tab)
            return
        time.sleep(INTERVAL)
        seen = restart_if_changed(seen, launched)


FRONTEND_NAMES = {"tui": "the TUI", "app": "the app"}


def options(command, rest):
    """(dry run, front end asked for) from what follows the repo; ends with
    the usage when something else does."""
    dry, asked, rest = False, None, list(rest)
    while rest:
        arg = rest.pop(0)
        if arg == "--dry-run" and command == "run":
            dry = True
        elif arg.startswith("--frontend="):
            asked = arg.partition("=")[2]
        elif arg == "--frontend" and rest:
            asked = rest.pop(0)
        else:
            sys.exit(USAGE)
    if asked == "":
        sys.exit(USAGE)
    return dry, asked


def pilots(name, picked, ask=frontend.ask):
    """Where the repo's pilot is: a (front end, tab) for each front end that
    has one, looking in the one picked, whether or not it answers, and in every
    other that answers. Leaves in use whichever it looked in last."""
    found = []
    for where in frontend.answering(picked, ask):
        frontend.use(where)
        tab = frontend.pilot(name)
        if tab:
            found.append((where, tab))
    return found


def alive(where, tab):
    frontend.use(where)
    return frontend.pilot_alive(tab)


def elsewhere(where, picked):
    """What a message adds when the pilot is not in the front end picked."""
    return "" if where == picked else f" (in {FRONTEND_NAMES[where]})"


def toggle(d, picked, ask=frontend.ask):
    found = pilots(session_name(d.name), picked, ask)
    for where, tab in found:
        frontend.use(where)
        frontend.close_tab(tab)
        print(f"{d.name}: autopilot off{elsewhere(where, picked)}")
    if not found:
        frontend.use(picked)
        turn_on(d)


def state(d, picked, ask=frontend.ask):
    """on, dead (the tab is there, the loop is not) or off, in any front end
    that answers: on wins over dead."""
    found = pilots(session_name(d.name), picked, ask)
    if any(alive(where, tab) for where, tab in found):
        return "on"
    return "dead" if found else "off"


def start(d, picked, ask=frontend.ask):
    """Turns the autopilot on in the front end picked, unless one is on in
    any front end that answers: a repo never has two."""
    found = pilots(session_name(d.name), picked, ask)
    for where, tab in found:
        if alive(where, tab):
            print(f"{d.name}: autopilot already on{elsewhere(where, picked)}")
            return
    for where, tab in found:
        frontend.use(where)
        frontend.close_tab(tab)
    if found:
        print(f"{d.name}: autopilot was dead{elsewhere(found[0][0], picked)}; restarting")
    frontend.use(picked)
    turn_on(d)


def turn_on(d):
    repo, name = d.name, session_name(d.name)
    command = f"{shlex.quote(str(Path(__file__).resolve()))} run {shlex.quote(str(d))}"
    cwd = str(d if d.is_dir() else ROOT)  # run clones a repo that is not here yet
    frontend.start_pilot(name, cwd, command)
    print(f"{repo}: autopilot on")


def main(argv):
    if argv == ["--self-test"]:
        sys.exit(0 if self_test() else 1)
    if len(argv) < 2 or argv[0] not in ("run", "start", "toggle", "state", "prepare"):
        sys.exit(USAGE)
    d = Path(os.path.normpath(ROOT / argv[1]))
    if not (d.parent == ROOT and re.fullmatch(r"[A-Za-z0-9._-]+", d.name)
            or argv[0] == "prepare" and d == ROOT):
        sys.exit(f"autopilot: {d} is not a repo of the workspace")
    if argv[0] == "prepare":
        prepare(d)
        return
    dry, asked = options(argv[0], argv[2:])
    picked = frontend.choose(asked)
    if argv[0] == "run":
        frontend.use(picked)
        loop(d, dry)
    elif argv[0] == "start":
        start(d, picked)
    elif argv[0] == "toggle":
        toggle(d, picked)
    else:
        print(state(d, picked))


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        log("autopilot off")
    except Failed as e:
        sys.exit(f"autopilot: {e}")
