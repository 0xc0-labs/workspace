# The other org repos, cloned in by bootstrap.sh; never committed here.
# /.github/ is load-bearing: without it, another repo's contents would sit at a
# path GitHub reads for workflows, CODEOWNERS and community health files.
/.github/
/claude-config/
/gitops/
/infrastructure/
/vault/
/packages/
/offby1.cc/
/artistlabco.com/
/matchmark/
/matchmark-config/
/matchmark-playground/
/app-*/

# One worktree per issue's session, placed by the 0xc0 plugin's WorktreeCreate
# hook (herdr/README.md, Autopilot).
/.worktrees/

# Claude Code's own worktrees, where the orchestrator's subagents work.
/.claude/worktrees/

# What Herdr's desktop app writes into a mod's folder when it loads or checks
# the mod (herdr/README.md, The picker in the app).
/herdr/mods/*/jsconfig.json
/herdr/mods/*/gpui-kit.d.ts

mise.local.toml

.DS_Store
